<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>MyFrames - Precision Authentication OTP Verification</title>

  <!-- Tailwind CSS v3 CDN with plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Newsreader', 'serif'],
            display: ['Cinzel', 'serif'],
          },
          colors: {
            brand: {
              charcoal: '#1a1d20',
              dark: '#111215',
              amber: '#c07129',
              gold: '#a66928',
              alertRedBg: '#fae3e3',
              alertRedText: '#b93838',
              alertGreenBg: '#f2f4f1',
              alertGreenText: '#2e4933',
            }
          }
        }
      }
    }
  </script>

  <style data-purpose="custom-styling">
    .radial-ambient-bg {
      background-color: #f7f9fa;
      background-image:
        radial-gradient(circle at 85% 75%, rgba(246, 218, 196, 0.45) 0%, rgba(246, 218, 196, 0) 55%),
        radial-gradient(circle at 15% 20%, rgba(235, 242, 248, 0.6) 0%, rgba(235, 242, 248, 0) 45%);
    }

    @keyframes pulse-dot {
      0%, 100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.4;
        transform: scale(0.85);
      }
    }

    .status-dot-active {
      animation: pulse-dot 2s infinite ease-in-out;
    }

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  </style>
</head>

<body class="bg-white text-gray-800 font-sans antialiased min-h-screen flex flex-col selection:bg-amber-100 selection:text-amber-900">

  <!-- BEGIN: TopRibbonBar -->

  <!-- BEGIN: TopNotificationBar -->
  <div class="bg-[#0b0f19] text-[#94a3b8] text-[10px] tracking-wider uppercase font-medium py-1.5 px-4 border-b border-gray-800"
    data-purpose="announcement-strip">

    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">

      <div class="flex items-center space-x-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>TITAN OPTICAL LAB • CERTIFIED • TOLERANCE ±0.01MM • COMPLIMENTARY 1.60 HIGH-INDEX LENSES</span>
      </div>

      <div class="flex items-center space-x-2">
        <span>FREE SHIPPING US &amp; INDIA • ISO 13485 ACCREDITED</span>
      </div>

    </div>
  </div>
  <!-- END: TopNotificationBar -->


  <!-- BEGIN: MainHeader -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">

      <!-- Brand Logo & Main Nav -->
      <div class="flex items-center space-x-6 flex-shrink-0">

        <a class="flex items-center space-x-2.5" href="#">

          <div class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center font-bold text-xs tracking-tighter">
            TF
          </div>

          <div>
            <div class="font-serif font-bold text-base tracking-tight text-gray-900 leading-none">
              MyFrames
            </div>

            <div class="text-[8px] tracking-[0.2em] uppercase font-semibold text-gray-400 leading-tight">
              PRECISION OPTICS
            </div>
          </div>

        </a>

        <!-- Eyeglasses dropdown -->
        <button
          class="hidden md:flex items-center space-x-1 text-xs font-semibold tracking-wider text-gray-800 hover:text-black uppercase"
          type="button">

          <span>EYEGLASSES</span>

          <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>

        </button>

      </div>


      <!-- Search Bar -->
      <div class="flex-1 max-w-xl mx-2 hidden sm:block">

        <div class="relative">

          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">

            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2">
              </path>
            </svg>

          </div>

          <input
            class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-full text-xs placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-gray-800 focus:bg-white transition-colors"
            placeholder="Search Titan, Hexagonal, Round, Panto..."
            type="text">

        </div>

      </div>


      <!-- Customer Icons -->
      <div class="flex items-center space-x-4 sm:space-x-6 flex-shrink-0">

        <!-- Wishlist -->
        <a class="flex flex-col items-center group relative text-gray-700 hover:text-black" href="#">

          <div class="relative">

            <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8">
              </path>
            </svg>

          </div>

          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">
            WISHLIST
          </span>

        </a>


        <!-- Cart -->
        <a class="flex flex-col items-center group relative text-gray-700 hover:text-black" href="#">

          <div class="relative">

            <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8">
              </path>
            </svg>

            <span class="absolute -top-1 -right-2 bg-red-600 text-white rounded-full text-[9px] w-3.5 h-3.5 flex items-center justify-center font-bold">
              0
            </span>

          </div>

          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">
            CART
          </span>

        </a>


        <!-- Profile -->
        <a class="flex flex-col items-center group text-gray-700 hover:text-black" href="#">

          <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8">
            </path>
          </svg>

          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">
            PROFILE
          </span>

        </a>

      </div>

    </div>

  </header>
  <!-- END: MainHeader -->


  <!-- BEGIN: MainContent -->

  <main
    class="flex-grow radial-ambient-bg py-10 px-4 flex flex-col justify-center items-center relative overflow-hidden"
    data-purpose="otp-verification-screen">

    <!-- Elevated Centered Card -->
    <div
      class="w-full max-w-[490px] bg-white rounded-3xl shadow-[0_12px_45px_rgba(0,0,0,0.06)] border border-gray-100 p-8 sm:p-9 relative z-10"
      data-purpose="verification-card">

      <!-- Top Mail Badge Icon -->
      <div class="flex justify-center mb-3">

        <div class="w-10 h-10 rounded-xl bg-orange-50 border border-orange-200/60 flex items-center justify-center text-amber-700 shadow-sm">

          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              stroke-linecap="round"
              stroke-linejoin="round">
            </path>
          </svg>

        </div>

      </div>


      <!-- Step Subtitle & Title -->
      <div class="text-center mb-3">

        <p class="text-[10px] tracking-[0.16em] uppercase font-semibold text-gray-400 mb-1">
          PRECISION AUTHENTICATION
        </p>

        <h1 class="font-serif text-3xl sm:text-[34px] font-medium text-gray-900 tracking-tight leading-tight">
          OTP Verification
        </h1>

      </div>


      <!-- Explanatory Copy -->
      <p class="text-center text-xs text-gray-500 leading-relaxed max-w-sm mx-auto mb-3">
        Enter the 6-digit OTP sent to your registered email address to access your bespoke prescriptions.
      </p>


      <!-- Email Pill Chip -->
      <div class="flex justify-center mb-5">

        <div class="bg-gray-100 border border-gray-200 rounded-full px-4 py-2 text-[11px] text-gray-600">
          <span id="verification-email"></span>
        </div>

      </div>


      <!-- Notification Alert: Invalid / Expired OTP -->
      <div
        class="mb-3 rounded-2xl bg-[#fee7e7] border border-[#fbd0d0] p-3 text-left relative flex items-start space-x-2.5"
        data-purpose="error-banner"
        id="alert-error">

        <div class="flex-shrink-0 mt-0.5 text-red-600">

          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" x2="12" y1="8" y2="12"></line>
            <line x1="12" x2="12.01" y1="16" y2="16"></line>
          </svg>

        </div>

        <div class="flex-1 text-[11px] leading-tight pr-4">

          <div class="font-bold text-red-800 mb-0.5">
            Invalid or Expired OTP
          </div>

          <div class="text-red-700 leading-snug">
            The code entered does not match our records or has expired. Please check your email or request a new OTP.
          </div>

        </div>

        <button
          class="text-red-400 hover:text-red-700 transition-colors absolute top-2.5 right-3 text-xs"
          onclick="document.getElementById('alert-error').style.display='none'"
          type="button">
          ✕
        </button>

      </div>


      <!-- Notification Alert: OTP Verified Successfully -->
      <div
        class="mb-5 rounded-2xl bg-[#f4f7f4] border border-[#e2eae2] p-3 text-left flex items-center justify-between"
        data-purpose="success-banner"
        id="alert-success">

        <div class="flex items-center space-x-2.5">

          <div class="w-4 h-4 rounded-full bg-[#346d41] text-white flex items-center justify-center flex-shrink-0 text-[9px] font-bold">
            ✓
          </div>

          <div class="text-[11px] leading-tight text-gray-800">

            <span class="font-semibold text-gray-900 block">
              OTP Verified successfully!
            </span>

          </div>

        </div>

      </div>


      <!-- Form: Digits Input Section -->
      <form id="otp-form">

        <div class="mb-4">

          <div class="flex justify-between items-center text-[10px] uppercase font-semibold text-gray-500 mb-2 px-1">

            <span class="tracking-wider">
              VERIFICATION DIGITS
            </span>

          </div>


          <!-- 6 Individual Digit Inputs -->
          <div class="grid grid-cols-6 gap-2 sm:gap-2.5" id="otp-inputs-container">

            <input
              class="otp-input w-full h-12 text-center text-lg font-medium text-gray-800 bg-[#edf1f5] border border-transparent rounded-2xl focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all outline-none"
              maxlength="1"
              type="text">

            <input
              class="otp-input w-full h-12 text-center text-lg font-medium text-gray-800 bg-[#edf1f5] border border-transparent rounded-2xl focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all outline-none"
              maxlength="1"
              type="text">

            <input
              class="otp-input w-full h-12 text-center text-lg font-medium text-gray-800 bg-[#edf1f5] border border-transparent rounded-2xl focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all outline-none"
              maxlength="1"
              type="text">

            <input
              class="otp-input w-full h-12 text-center text-lg font-medium text-gray-400 bg-[#edf1f5] border border-transparent rounded-2xl focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all outline-none"
              maxlength="1"
              type="text">

            <input
              class="otp-input w-full h-12 text-center text-lg font-medium text-gray-400 bg-[#edf1f5] border border-transparent rounded-2xl focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all outline-none"
              maxlength="1"
              type="text">

            <input
              class="otp-input w-full h-12 text-center text-lg font-medium text-gray-400 bg-[#edf1f5] border border-transparent rounded-2xl focus:bg-white focus:border-amber-600 focus:ring-1 focus:ring-amber-600 transition-all outline-none"
              maxlength="1"
              type="text">

          </div>

        </div>


        <!-- Security Timer & Resend Option -->
        <div class="flex items-center justify-between text-xs mb-5 px-1">

          <!-- Timer -->
          <div class="flex items-center space-x-1.5 text-amber-800 font-medium">

            <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>

            <span class="text-[11px] text-gray-700">
              Security Window:
              <strong class="text-amber-800 font-bold" id="countdown-timer">
                01:45
              </strong>
            </span>

          </div>


          <!-- Resend Action -->
          <button
            class="flex items-center space-x-1 text-[11px] font-semibold text-amber-800 hover:text-amber-900 transition-colors"
            id="resend-btn"
            type="button">

            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2">
              </path>
            </svg>

            <span>Resend OTP</span>

          </button>

        </div>


        <!-- Primary Verification CTA -->
        <button
          class="w-full bg-[#24272c] hover:bg-[#15171a] text-white font-medium text-xs tracking-wider uppercase py-3.5 px-6 rounded-full shadow-md hover:shadow-lg transition duration-200 flex items-center justify-center space-x-2"
          id="verify-submit-button"
          type="submit">

          <span>VERIFY OTP</span>
          <span class="text-sm leading-none">→</span>

        </button>

      </form>


      <!-- Back to Login Navigation -->
      <div class="mt-4 text-center">

        <a
          class="inline-flex items-center space-x-1 text-xs font-semibold text-gray-700 hover:text-black transition-colors"
          href="/login.html">

          <span>←</span>
          <span>Back to Login</span>

        </a>

      </div>


      <!-- Need Assistance Support Line -->
      <div class="mt-5 pt-4 border-t border-gray-100 text-center flex items-center justify-center space-x-1.5 text-xs text-gray-500">

        <span><br></span>

        <a
          class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2"
          href="#">
          <br>
        </a>

      </div>

    </div>


    <!-- Trust Badges Under Card -->

  </main>
  <!-- END: MainContent -->


  <!-- BEGIN: ThreeColumnFooter -->

  <footer
    class="bg-[#070b13] text-gray-400 text-xs border-t border-gray-900"
    data-purpose="site-footer">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">

        <!-- Left Brand & Lab Specs -->
        <div class="md:col-span-5 space-y-4">

          <div class="flex items-center space-x-3">

            <div class="w-7 h-7 rounded-full bg-amber-600 text-black flex items-center justify-center font-bold text-xs">
              TF
            </div>

            <div>

              <span class="font-serif font-bold text-sm tracking-tight text-white block">
                MyFrames Precision
              </span>

              <span class="text-[8px] tracking-[0.2em] uppercase font-semibold text-amber-500 block leading-tight">
                CERTIFIED OPHTHALMIC LABORATORY
              </span>

            </div>

          </div>


          <p class="text-xs text-gray-400 max-w-sm leading-relaxed">
            Medical-grade beta titanium and hand-carved cellulose acetate frames. Engineered with sub-millimeter precision in our certified optical research facility.
          </p>


          <div class="pt-2 text-[10px] space-y-1">

            <div class="flex items-center text-emerald-400 font-semibold tracking-wider uppercase">

              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-2"></span>

              SYSTEM STATUS: ALL LABS OPERATIONAL

            </div>

            <div class="text-gray-500 uppercase tracking-widest text-[9px]">
              ISO 13485 CERTIFIED
            </div>

          </div>

        </div>


        <!-- Middle Column 1 -->
        <div class="md:col-span-2 space-y-3">

          <h4 class="text-[10px] font-bold uppercase tracking-widest text-white">
            LAB ENGINEERING
          </h4>

          <ul class="space-y-2 text-xs text-gray-400">

            <li><a class="hover:text-white transition-colors" href="#">0.01mm Laser Precision</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Refractive Index Profiling</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Laser Axis Calibration</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Digital Free-Form Surfacing</a></li>

          </ul>

        </div>


        <!-- Middle Column 2 -->
        <div class="md:col-span-2 space-y-3">

          <h4 class="text-[10px] font-bold uppercase tracking-widest text-white">
            CUSTOMER SUPPORT
          </h4>

          <ul class="space-y-2 text-xs text-gray-400">

            <li><a class="hover:text-white transition-colors" href="#">Optometrist Video Consultation</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Eyeglasses Fit Guarantee</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Complimentary Frame Adjustments</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Order Tracking &amp; Telemetry</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Titan Optical Lab Network</a></li>

          </ul>

        </div>


        <!-- Right Column -->
        <div class="md:col-span-3 space-y-3">

          <h4 class="text-[10px] font-bold uppercase tracking-widest text-white">
            OPTICAL JOURNAL
          </h4>

          <p class="text-[11px] text-gray-400 leading-snug">
            Subscribe to receive laboratory dispatch notes, lens tech whitepapers, and seasonal catalog releases.
          </p>

          <form class="flex items-center gap-1.5 pt-1" onsubmit="event.preventDefault();">

            <input
              class="bg-gray-900 border border-gray-800 text-xs px-3 py-2 rounded text-gray-200 placeholder-gray-600 focus:outline-none focus:border-amber-500 w-full"
              placeholder="Enter laboratory email"
              type="email">

            <button
              class="bg-amber-600 hover:bg-amber-500 text-black font-bold uppercase text-[10px] tracking-wider px-3 py-2 rounded transition-colors"
              type="submit">
              JOIN
            </button>

          </form>

        </div>

      </div>


      <!-- Copyright & Legal -->
      <div class="mt-12 pt-6 border-t border-gray-900 flex flex-wrap justify-between items-center text-[10px] text-gray-500 gap-4">

        <div>
          © 2025 TF MyFrames Precision Optics. All rights reserved.
        </div>

        <div class="flex items-center space-x-6">

          <a class="hover:text-gray-400 transition-colors" href="#">
            Medical Privacy &amp; HIPAA
          </a>

          <a class="hover:text-gray-400 transition-colors" href="#">
            Terms of Bespoke Service
          </a>

          <a class="hover:text-gray-400 transition-colors" href="#">
            Laboratory Standards
          </a>

        </div>

      </div>

    </div>

  </footer>
  <!-- END: ThreeColumnFooter -->


  <!-- OTP JavaScript -->
  <script src="/js/otpverification.js"></script>

</body>

</html>