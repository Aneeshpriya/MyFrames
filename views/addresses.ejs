
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Addresses — TF MyFrames Precision Optics</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Playfair Display"', 'Georgia', 'serif'],
            sans: ['Inter', 'sans-serif'],
            cinzel: ['Cinzel', 'serif']
          },
          colors: {
            brand: {
              navy: '#090E17',
              navyCard: '#0D1424',
              slate: '#1E293B',
              bronze: '#C27835',
              bronzeDark: '#A85D23',
              accent: '#38BDF8',
              mutedBg: '#F8FAFC'
            }
          }
        }
      }
    }
  </script>

  <style>
    .font-serif-title {
      font-family: 'Playfair Display', Georgia, serif;
      letter-spacing: -0.015em;
    }

    .badge-subtle-glow {
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.15);
    }
  </style>
</head>

<body class="bg-[#FBFBFC] text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-amber-100 selection:text-amber-900">

  <!-- Announcement Bar -->
  <aside class="w-full bg-[#070D18] text-[#38BDF8] py-2 px-4 border-b border-[#1E2E4A]/40 text-[10.5px] tracking-wider uppercase font-medium">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">

      <div class="flex items-center space-x-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-white font-semibold">TITAN OPTICAL LAB</span>
        <span class="text-slate-500">|</span>
        <span class="text-slate-300">CERTIFIED • TOLERANCE ±0.01MM</span>
        <span class="text-slate-500">|</span>
        <span class="text-cyan-400 font-medium">COMPLIMENTARY 1.60 HIGH-INDEX LENSES</span>
      </div>

      <div class="flex items-center space-x-2 text-slate-400">
        <span>FREE SHIPPING US & INDIA</span>
        <span class="text-slate-600">•</span>
        <span class="text-slate-300">ISO 13485 ACCREDITED</span>
      </div>

    </div>
  </aside>


  <!-- Main Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-6">

      <!-- Logo -->
      <div class="flex items-center space-x-8">
        <a class="flex items-center gap-3 group" href="/">
          <div class="w-10 h-10 rounded-full bg-[#0A111E] flex items-center justify-center text-white font-serif font-bold text-sm tracking-wider shadow-sm">
            TF
          </div>

          <div class="flex flex-col">
            <span class="font-serif text-xl tracking-tight font-bold text-slate-900 leading-tight">MyFrames</span>
            <span class="text-[9px] tracking-[0.25em] text-slate-500 font-semibold uppercase">Precision Optics</span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center">
          <button class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-800 hover:text-amber-700 transition-colors py-2" type="button">
            <span>Eyeglasses</span>
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </nav>
      </div>

      <!-- Search -->
      <div class="flex-1 max-w-xl mx-4 hidden sm:block">
        <div class="relative w-full">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </div>

          <input class="w-full pl-10 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-full focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900 focus:border-slate-900 transition-all placeholder:text-slate-400"
            placeholder="Search Titan, Hexagonal, Round, Panto..."
            type="text">
        </div>
      </div>

      <!-- Header Utilities -->
      <div class="flex items-center space-x-6 text-slate-700">

        <a class="relative flex flex-col items-center group text-slate-700 hover:text-slate-900" href="#">
          <svg class="w-5 h-5 transition-transform group-hover:scale-105" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="text-[9px] uppercase tracking-wider font-medium mt-0.5 text-slate-500">Wishlist</span>
        </a>

        <a class="flex flex-col items-center group relative text-gray-700 hover:text-black" href="#">
<div class="relative">
<svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
</svg>

</div>
<span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">CART</span>
</a>

        <a class="flex flex-col items-center group text-slate-700 hover:text-slate-900" href="/profile">
          <svg class="w-5 h-5 transition-transform group-hover:scale-105" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="text-[9px] uppercase tracking-wider font-semibold mt-0.5 text-slate-800">Profile</span>
        </a>

      </div>
    </div>
  </header>


  <!-- Main Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-7">

    <!-- Back to Profile -->
    <div class="flex items-center justify-between text-xs pb-6">
      <a class="text-[11px] font-semibold uppercase tracking-wider text-amber-800 hover:text-amber-950 flex items-center gap-1.5 group" href="/profile">
        <span class="group-hover:-translate-x-0.5 transition-transform">←</span>
        <span>Back to Profile</span>
      </a>
    </div>


    <!-- Section Title -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-7">

      <div class="space-y-2.5 max-w-2xl">
        <h1 class="text-3xl sm:text-4xl font-serif text-slate-900 font-normal tracking-tight">
          My Addresses
        </h1>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-xl">
          Premium titanium frames and high-index lenses, carefully packaged and securely delivered to your doorstep.
        </p>
      </div>

      <!-- Add New Address -->
      <div>
        <a href="/add-address"
          class="inline-flex items-center gap-2 bg-[#D97706] hover:bg-[#B45309] text-white text-xs font-semibold px-5 py-3 rounded-full shadow-sm hover:shadow transition-all duration-150 uppercase tracking-wider">

          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
          </svg>

          <span>Add New Address</span>
        </a>
      </div>

    </section>


    <!-- Guarantee Information -->
    <section class="grid grid-cols-1 gap-4 mb-9 md:grid-cols-2">

      <div class="bg-emerald-400/10 border border-emerald-400/20 rounded-2xl p-4 sm:p-5 flex items-start gap-4 shadow-sm">

        <div class="w-9 h-9 rounded-full bg-emerald-400/20 border border-emerald-400/40 flex-shrink-0 flex items-center justify-center text-emerald-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
        </div>

        <div>
          <h3 class="text-xs sm:text-[13px] font-serif font-bold text-slate-900 tracking-tight">Secure Shipping</h3>
          <p class="text-[11px] text-slate-600 mt-1 leading-snug">Complimentary shipping insurance for added peace of mind.</p>
        </div>

      </div>


      <div class="bg-amber-50 border border-amber-100 rounded-2xl p-4 sm:p-5 flex items-start gap-4 shadow-sm">

        <div class="w-9 h-9 rounded-full bg-amber-100 border border-amber-200 flex-shrink-0 flex items-center justify-center text-amber-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
        </div>

        <div>
          <h3 class="text-xs sm:text-[13px] font-serif font-bold text-slate-900 tracking-tight">Verified Delivery</h3>
          <p class="text-[11px] text-slate-600 mt-1 leading-snug">Orders are securely handed over after recipient OTP verification.</p>
        </div>

      </div>

    </section>


    <!-- Saved Address Cards -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12" data-purpose="saved-addresses-grid">

      <% if (user.addresses && user.addresses.length > 0) { %>

        <% user.addresses.forEach((address) => { %>

          <article class="bg-white rounded-2xl border border-slate-200/90 p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow relative">

            <div>

              <!-- Address Type -->
              <div class="flex items-center justify-between mb-4">

                <% if (address.addressType === "Home") { %>

                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-900 text-slate-100 tracking-wider">
                    HOME
                  </span>

                <% } else if (address.addressType === "Work") { %>

                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-cyan-50 text-cyan-800 border border-cyan-200/60 tracking-wider">
                    WORK
                  </span>

                <% } else { %>

                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200 tracking-wider">
                    OTHER
                  </span>

                <% } %>

                <div class="w-7 h-7 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-700">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                  </svg>
                </div>

              </div>


              <!-- Name -->
              <h2 class="text-base font-serif font-bold text-slate-900">
                <%= address.fullName %>
              </h2>


              <!-- Phone -->
              <p class="text-xs text-slate-600 mt-1 flex items-center gap-1.5 font-sans">

                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>

                <%= address.phoneNumber %>
              </p>


              <!-- Address Details -->
              <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-600 space-y-1">

                <p><%= address.houseName %></p>

                <p><%= address.street %></p>

                <% if (address.landmark) { %>
                  <p>Near <%= address.landmark %></p>
                <% } %>

                <p>
                  <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                </p>

                <p class="text-[10px] font-bold tracking-widest text-slate-400 uppercase pt-1">
                  <%= address.country %>
                </p>

              </div>

            </div>


            <!-- Edit and Delete Buttons -->
            <div class="mt-6 pt-4 flex items-center space-x-2">

              <!-- Edit -->
              <a href="/edit-address/<%= address._id %>"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-700 hover:text-slate-900 border border-slate-200 text-[11px] font-semibold rounded-full transition-colors">

                <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>

                <span>EDIT</span>
              </a>


              <!-- Delete -->
              <button
                onclick="deleteAddress('<%= address._id %>')"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-rose-50 hover:text-rose-600 border border-slate-200 text-slate-700 text-[11px] font-semibold rounded-full transition-colors"
                type="button">

                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>

                <span>DELETE</span>
              </button>

            </div>

          </article>

        <% }) %>

      <% } else { %>

        <!-- No Address Found -->
        <div class="col-span-full bg-white border border-slate-200 rounded-2xl p-10 text-center shadow-sm">

          <div class="w-14 h-14 mx-auto rounded-full bg-amber-50 flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 21s8-4.5 8-11a8 8 0 10-16 0c0 6.5 8 11 8 11z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
              <circle cx="12" cy="10" r="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></circle>
            </svg>
          </div>

          <h2 class="text-lg font-serif font-bold text-slate-900">
            No Saved Addresses
          </h2>

          <p class="text-xs text-slate-500 mt-2 mb-5">
            You haven't added any delivery addresses yet.
          </p>

          <a href="/add-address"
            class="inline-flex items-center gap-2 bg-[#D97706] hover:bg-[#B45309] text-white text-xs font-semibold px-5 py-3 rounded-full transition-colors uppercase tracking-wider">
            Add Your First Address
          </a>

        </div>

      <% } %>

    </section>

  </main>


  <!-- Main Footer -->
  <footer class="bg-[#080E18] text-slate-300 pt-16 pb-8 border-t border-slate-800">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800/80">

        <!-- About -->
        <div class="space-y-4">
          <h4 class="font-serif text-xl tracking-tight text-white font-bold">TF MyFrames</h4>

          <p class="text-xs text-slate-400 leading-relaxed">
            Medical-grade titanium and hand-carved cellulose acetate frames. Engineered with sub-millimeter precision in our certified optical research facility.
          </p>

          <div class="flex flex-wrap gap-2 pt-1">
            <span class="text-[9px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded border border-slate-700 text-slate-400 bg-slate-900/50">
              ISO 13485 CERTIFIED
            </span>

            <span class="text-[9px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded border border-slate-700 text-slate-400 bg-slate-900/50">
              CLASS 1 MEDICAL DEVICE
            </span>
          </div>
        </div>


        <!-- Lab Engineering -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-slate-200 mb-4 font-mono">Lab Engineering</h4>

          <ul class="space-y-2.5 text-xs text-slate-400">
            <li><a class="hover:text-white transition-colors" href="#">Ti-811 Beta Titanium</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Refractive Index Profiling</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Laser Axis Calibration</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Digital Free-Form Surfacing</a></li>
          </ul>
        </div>


        <!-- Customer Support -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-slate-200 mb-4 font-mono">Customer Support</h4>

          <ul class="space-y-2.5 text-xs text-slate-400">
            <li><a class="hover:text-white transition-colors" href="#">Optometrist Video Consultation</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Pupillary Distance Tool</a></li>
            <li><a class="hover:text-white transition-colors" href="#">International Freight & Duties</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Atelier Warranty & Tune-ups</a></li>
          </ul>
        </div>


        <!-- Newsletter -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-slate-200 mb-4 font-mono">Optical Journal</h4>

          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Receive monograph updates on ophthalmic engineering and bespoke frame silhouettes.
          </p>

          <form class="flex items-center">
            <input class="w-full bg-[#0F1728] border border-slate-700 rounded-l-md px-3 py-2 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-600"
              placeholder="optics@steller.com"
              type="email">

            <button class="bg-[#D97706] hover:bg-[#B45309] text-white px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-r-md transition-colors" type="button">
              JOIN
            </button>
          </form>
        </div>

      </div>


      <!-- Bottom Bar -->
      <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">

        <div>
          © 2025 TF MyFrames Precision Optics. All rights reserved.
        </div>

        <div class="flex items-center space-x-6 text-[11px]">
          <a class="hover:text-slate-300 transition-colors" href="#">Medical Privacy & HIPAA</a>
          <a class="hover:text-slate-300 transition-colors" href="#">Terms of Bespoke Service</a>
          <a class="hover:text-slate-300 transition-colors" href="#">Laboratory Standards</a>
        </div>

      </div>

    </div>

  </footer>


  <!-- Delete Address JavaScript -->
  <script>
    async function deleteAddress(addressId) {

      const confirmDelete = confirm("Are you sure you want to delete this address?");

      if (!confirmDelete) {
        return;
      }

      try {

        const response = await fetch(`/api/users/delete-address/${addressId}`, {
          method: "DELETE",
          credentials: "include"
        });

        const data = await response.json();

        if (response.ok && data.success) {

          alert("Address deleted successfully.");

          window.location.reload();

        } else {

          alert(data.message || "Failed to delete address.");

        }

      } catch (error) {

        console.error("Delete address error:", error);

        alert("Something went wrong. Please try again.");

      }

    }
  </script>

</body>
</html>
