
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyFrames - Reset Password</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #121824;
      --gold: #b45309;
      --surface-bg: #f8f9fa;
      --text-main: #111827;
      --text-muted: #6b7280;
      --success: #15803d;
      --error: #b91c1c;
      --font-serif: 'EB Garamond', Georgia, serif;
      --font-sans: 'Inter', sans-serif;
    }

    body {
      font-family: var(--font-sans);
      background: var(--surface-bg);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .top-lab-bar {
      background: #0b0f19;
      color: #94a3b8;
      font-size: 11px;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: 7px 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-nav {
      background: #fff;
      border-bottom: 1px solid #eef0f2;
      padding: .9rem 2.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .brand-section, .logo-container {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-badge {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #0b0f19;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
    }

    .logo-text-group {
      display: flex;
      flex-direction: column;
    }

    .logo-title {
      font-size: 19px;
      font-weight: 700;
      color: #0b0f19;
    }

    .logo-subtitle {
      font-size: 8.5px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 600;
      color: #64748b;
    }

    .nav-category-link {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .action-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      color: #334155;
      font-size: 11px;
    }

    .action-btn svg {
      width: 19px;
      height: 19px;
    }

    .main-content {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3.5rem 1.5rem;
      background: radial-gradient(circle at 50% 30%, rgba(180,83,9,.035), #f8f9fa 70%);
    }

    .reset-card-container {
      width: 100%;
      max-width: 480px;
    }

    .reset-card {
      background: #fff;
      border-radius: 20px;
      padding: 2.75rem 2.5rem;
      border: 1px solid #eef0f3;
      box-shadow: 0 12px 35px -8px rgba(0,0,0,.06);
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .reset-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg,#d97706,#b45309,#92400e);
    }

    .card-title {
      font-family: var(--font-serif);
      font-size: 2.25rem;
      font-weight: 500;
      color: #0f172a;
      margin: 1.5rem 0 .75rem;
    }

    .card-description {
      font-size: 13.5px;
      line-height: 1.55;
      color: #4b5563;
      margin-bottom: 2rem;
    }

    .form-group {
      text-align: left;
      margin-bottom: 1.25rem;
    }

    .form-label {
      display: block;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #374151;
      margin-bottom: .45rem;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon-left {
      position: absolute;
      left: 16px;
      color: #9ca3af;
      pointer-events: none;
    }

    .form-input {
      width: 100%;
      height: 48px;
      padding: 0 46px 0 44px;
      background: #fff;
      border: 1px solid #d1d5db;
      border-radius: 9999px;
      font-family: var(--font-sans);
      font-size: 13.5px;
      outline: none;
    }

    .form-input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(180,83,9,.15);
    }

    .form-input.is-invalid {
      border-color: var(--error);
    }

    .form-input.is-valid {
      border-color: var(--success);
    }

    .toggle-password-btn {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      padding: 6px;
      cursor: pointer;
      color: #6b7280;
    }

    .validation-card {
      background: #fafaf9;
      border: 1px solid #e7e5e4;
      border-radius: 12px;
      padding: .9rem 1.1rem;
      margin: .5rem 0 1.5rem;
      text-align: left;
    }

    .validation-header {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      color: #57534e;
      margin-bottom: .55rem;
    }

    .criteria-list {
      list-style: none;
      display: grid;
      gap: .4rem;
    }

    .criteria-item {
      font-size: 12px;
      color: #78716c;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .criteria-item svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    .criteria-item.met {
      color: #15803d;
      font-weight: 500;
    }

    .criteria-item.unmet {
      color: #78716c;
    }

    .match-status-msg {
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 6px;
      margin-top: 6px;
      display: none;
      text-align: left;
    }

    .match-status-msg.error {
      display: block;
      color: var(--error);
      background: #fef2f2;
      border: 1px solid #fecaca;
    }

    .match-status-msg.success {
      display: block;
      color: var(--success);
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
    }

    .btn-submit {
      width: 100%;
      height: 48px;
      background: #121824;
      color: #fff;
      border: none;
      border-radius: 9999px;
      font-family: var(--font-sans);
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: .5rem;
    }

    .btn-submit:hover:not(:disabled) {
      background: #1e293b;
    }

    .btn-submit:disabled {
      background: #94a3b8;
      cursor: not-allowed;
    }

    .back-link-wrapper {
      margin-top: 1.5rem;
    }

    .back-link {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #4b5563;
    }

    .security-badges-row {
      margin-top: 1.85rem;
      padding-top: 1.25rem;
      border-top: 1px dashed #e5e7eb;
      font-size: 10px;
      color: #9ca3af;
    }

    .footer-dark {
      background: #070b13;
      color: #cbd5e1;
      padding: 3.5rem 3rem 2rem;
    }

    .footer-grid {
      max-width: 1280px;
      margin: 0 auto 3rem;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
      gap: 3rem;
    }

    .footer-brand-title {
      font-size: 16px;
      font-weight: 700;
      color: #fff;
      margin-bottom: .6rem;
    }

    .footer-brand-sub {
      font-size: 9.5px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #f59e0b;
      font-weight: 700;
      margin-bottom: .9rem;
    }

    .footer-brand-desc, .newsletter-text {
      font-size: 12px;
      line-height: 1.6;
      color: #94a3b8;
      margin-bottom: 1rem;
    }

    .footer-col-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #fff;
      margin-bottom: 1.25rem;
    }

    .footer-links-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .65rem;
    }

    .footer-link-item a {
      font-size: 12px;
      color: #94a3b8;
    }

    .newsletter-form {
      display: flex;
      gap: 6px;
    }

    .newsletter-input {
      flex: 1;
      background: #131c2e;
      border: 1px solid #1e293b;
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 12px;
      color: #fff;
    }

    .newsletter-btn {
      background: #b45309;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0 16px;
      cursor: pointer;
    }

    .footer-bottom-bar {
      max-width: 1280px;
      margin: 0 auto;
      padding-top: 1.75rem;
      border-top: 1px solid rgba(255,255,255,.08);
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: #64748b;
    }

    .footer-legal-links {
      display: flex;
      gap: 1.5rem;
    }

    @media(max-width:900px) {
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media(max-width:600px) {
      .header-nav {
        padding: .75rem 1rem;
      }
      .top-lab-bar {
        display: none;
      }
      .reset-card {
        padding: 2rem 1.25rem;
      }
      .footer-grid {
        grid-template-columns: 1fr;
      }
      .footer-bottom-bar {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
      }
    }
  </style>
</head>

<body>

  <div class="top-lab-bar">
    <span>TITAN OPTICAL LAB • CERTIFIED</span>
    <span>FREE SHIPPING US & INDIA • ISO 13485 ACCREDITED</span>
  </div>

  <header class="header-nav">
    <div class="brand-section">
      <a href="/" class="logo-container">
        <div class="logo-badge">TF</div>
        <div class="logo-text-group">
          <span class="logo-title">MyFrames</span>
          <span class="logo-subtitle">Precision Optics</span>
        </div>
      </a>
      <a href="/eyeglasses" class="nav-category-link">EYEGLASSES</a>
    </div>

    <div class="header-actions">
      <a href="/wishlist" class="action-btn">♡<span>Wishlist</span></a>
      <a href="/cart" class="action-btn">🛒<span>Cart</span></a>
      <a href="/login" class="action-btn">♙<span>Profile</span></a>
    </div>
  </header>

  <main class="main-content">
    <div class="reset-card-container">
      <div class="reset-card">

        <div class="logo-container" style="justify-content:center;">
          <div class="logo-badge">TF</div>
          <div class="logo-text-group" style="text-align:left;">
            <span class="logo-title">MyFrames</span>
            <span class="logo-subtitle">Precision Optics</span>
          </div>
        </div>

        <h1 class="card-title">Reset Password</h1>

        <p class="card-description">
          Create a new password for your MyFrames account. Make sure it meets the password requirements below.
        </p>

        <form id="resetPasswordForm">

          <div class="form-group">
            <label class="form-label" for="newPassword">New Password</label>

            <div class="input-wrapper">
              <span class="input-icon-left">🔒</span>

              <input
                type="password"
                id="newPassword"
                name="newPassword"
                class="form-input"
                placeholder="Enter new password"
                required
                autocomplete="new-password"
              >

              <button type="button" class="toggle-password-btn" id="toggleNewPasswordBtn">
                <svg id="newPasswordEyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <div class="validation-card">
            <div class="validation-header">Password Requirements</div>

            <ul class="criteria-list">
              <li class="criteria-item unmet" id="critLength">
                <span>○</span>
                <span>Minimum 6 characters</span>
              </li>

              <li class="criteria-item unmet" id="critUpper">
                <span>○</span>
                <span>At least one uppercase letter (A-Z)</span>
              </li>

              <li class="criteria-item unmet" id="critLower">
                <span>○</span>
                <span>At least one lowercase letter (a-z)</span>
              </li>

              <li class="criteria-item unmet" id="critNumber">
                <span>○</span>
                <span>At least one number (0-9)</span>
              </li>
            </ul>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm Password</label>

            <div class="input-wrapper">
              <span class="input-icon-left">✓</span>

              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                class="form-input"
                placeholder="Re-enter new password"
                required
                autocomplete="new-password"
              >

              <button type="button" class="toggle-password-btn" id="toggleConfirmPasswordBtn">
                <svg id="confirmPasswordEyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>

            <div class="match-status-msg" id="matchStatusMsg"></div>
          </div>

          <button type="submit" id="resetPasswordBtn" class="btn-submit">
            <span>Reset Password</span>
          </button>

          <div class="back-link-wrapper">
            <a href="/login" class="back-link">← Back to Login</a>
          </div>

          <div class="security-badges-row">
            Secure Password Reset • MyFrames
          </div>

        </form>
      </div>
    </div>
  </main>

  <footer class="footer-dark">
    <div class="footer-grid">

      <div>
        <div class="footer-brand-title">TF MyFrames Precision</div>
        <div class="footer-brand-sub">Certified Ophthalmic Laboratory</div>
        <p class="footer-brand-desc">
          Medical-grade frames engineered with precision for your everyday comfort.
        </p>
      </div>

      <div>
        <h4 class="footer-col-title">Lab Engineering</h4>
        <ul class="footer-links-list">
          <li class="footer-link-item"><a href="#">Precision Frames</a></li>
          <li class="footer-link-item"><a href="#">Optical Technology</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">Customer Support</h4>
        <ul class="footer-links-list">
          <li class="footer-link-item"><a href="#">Order Tracking</a></li>
          <li class="footer-link-item"><a href="#">Customer Care</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">Optical Journal</h4>
        <p class="newsletter-text">
          Subscribe to receive updates and new collection announcements.
        </p>
        <form class="newsletter-form" onsubmit="event.preventDefault();">
          <input type="email" class="newsletter-input" placeholder="Enter email">
          <button type="submit" class="newsletter-btn">JOIN</button>
        </form>
      </div>

    </div>

    <div class="footer-bottom-bar">
      <div>© 2025 TF MyFrames Precision Optics. All rights reserved.</div>
      <div class="footer-legal-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
      </div>
    </div>
  </footer>

  <script>
    (() => {
      const form = document.getElementById("resetPasswordForm");
      const newPasswordInput = document.getElementById("newPassword");
      const confirmPasswordInput = document.getElementById("confirmPassword");
      const resetBtn = document.getElementById("resetPasswordBtn");
      const matchStatusMsg = document.getElementById("matchStatusMsg");

      const criteria = {
        length: document.getElementById("critLength"),
        upper: document.getElementById("critUpper"),
        lower: document.getElementById("critLower"),
        number: document.getElementById("critNumber")
      };

      function updateCriteria(element, met) {
        const label = element.querySelectorAll("span")[1].textContent;
        element.className = met ? "criteria-item met" : "criteria-item unmet";
        element.innerHTML = `<span>${met ? "✓" : "○"}</span><span>${label}</span>`;
      }

      function validatePassword() {
        const password = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        const validLength = password.length >= 6;
        const validUpper = /[A-Z]/.test(password);
        const validLower = /[a-z]/.test(password);
        const validNumber = /[0-9]/.test(password);

        updateCriteria(criteria.length, validLength);
        updateCriteria(criteria.upper, validUpper);
        updateCriteria(criteria.lower, validLower);
        updateCriteria(criteria.number, validNumber);

        const strengthValid = validLength && validUpper && validLower && validNumber;

        let passwordsMatch = false;

        if (confirmPassword.length > 0) {
          if (password === confirmPassword) {
            matchStatusMsg.className = "match-status-msg success";
            matchStatusMsg.textContent = "✓ Passwords match perfectly.";
            confirmPasswordInput.classList.remove("is-invalid");
            confirmPasswordInput.classList.add("is-valid");
            passwordsMatch = true;
          } else {
            matchStatusMsg.className = "match-status-msg error";
            matchStatusMsg.textContent = "✕ Passwords do not match.";
            confirmPasswordInput.classList.remove("is-valid");
            confirmPasswordInput.classList.add("is-invalid");
          }
        } else {
          matchStatusMsg.className = "match-status-msg";
          matchStatusMsg.textContent = "";
          confirmPasswordInput.classList.remove("is-valid", "is-invalid");
        }

        return strengthValid && passwordsMatch;
      }

      function setupToggle(input, button, icon) {
        button.addEventListener("click", () => {
          const showPassword = input.type === "password";
          input.type = showPassword ? "text" : "password";

          icon.innerHTML = showPassword
            ? `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>`
            : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>`;
        });
      }

      setupToggle(
        newPasswordInput,
        document.getElementById("toggleNewPasswordBtn"),
        document.getElementById("newPasswordEyeIcon")
      );

      setupToggle(
        confirmPasswordInput,
        document.getElementById("toggleConfirmPasswordBtn"),
        document.getElementById("confirmPasswordEyeIcon")
      );

      newPasswordInput.addEventListener("input", validatePassword);
      confirmPasswordInput.addEventListener("input", validatePassword);

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!validatePassword()) {
          if (!confirmPasswordInput.value) {
            matchStatusMsg.className = "match-status-msg error";
            matchStatusMsg.textContent = "Please confirm your new password.";
            confirmPasswordInput.focus();
          }
          return;
        }

        resetBtn.disabled = true;
        resetBtn.querySelector("span").textContent = "Updating Password...";

        try {
          const response = await fetch("/api/users/reset-password", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              newPassword: newPasswordInput.value,
              confirmPassword: confirmPasswordInput.value
            })
          });

          const data = await response.json();

          if (!response.ok || data.success === false) {
            alert(data.message || "Password reset failed.");
            return;
          }

          alert(data.message || "Password reset successfully!");
          window.location.href = "/login";

        } catch (error) {
          console.error("Reset password error:", error);
          alert("Something went wrong. Please try again.");
        } finally {
          resetBtn.disabled = false;
          resetBtn.querySelector("span").textContent = "Reset Password";
        }
      });
    })();
  </script>

</body>
</html>
