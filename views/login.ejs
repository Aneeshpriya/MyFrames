
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>MyFrames - Client Portal Login &amp; Welcome Back</title>

  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"EB Garamond"', 'serif'],
            sans: ['"Inter"', 'sans-serif'],
          },
          colors: {
            brand: {
              charcoal: '#141414',
              gold: '#c2782e',
              goldHover: '#a76522',
              cream: '#f9f8f6',
              surface: '#f3f2ee',
              border: '#e4e2dc',
              muted: '#71716e'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
      -webkit-font-smoothing: antialiased;
    }

    .custom-shadow {
      box-shadow: 0 20px 40px -15px rgba(20, 20, 20, 0.07), 0 0 1px 1px rgba(20, 20, 20, 0.05);
    }
  </style>
</head>

<body class="bg-[#fbfbf9] text-brand-charcoal font-sans min-h-screen flex flex-col justify-between selection:bg-brand-charcoal selection:text-white">

  <div class="bg-[#0b0f19] text-[#94a3b8] text-[10px] tracking-wider uppercase font-medium py-1.5 px-4 border-b border-gray-800">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center space-x-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>TITAN OPTICAL LAB • CERTIFIED • TOLERANCE ±0.01MM • COMPLIMENTARY 1.60 HIGH-INDEX LENSES</span>
      </div>
      <div class="flex items-center space-x-2">
        <span>FREE SHIPPING US &amp; INDIA • ISO 13485 ACCREDITED</span>
      </div>
    </div>
  </div>

  <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">

      <div class="flex items-center space-x-6 flex-shrink-0">
        <a class="flex items-center space-x-2.5" href="#">
          <div class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center font-bold text-xs tracking-tighter">
            TF
          </div>
          <div>
            <div class="font-serif font-bold text-base tracking-tight text-gray-900 leading-none">MyFrames</div>
            <div class="text-[8px] tracking-[0.2em] uppercase font-semibold text-gray-400 leading-tight">PRECISION OPTICS</div>
          </div>
        </a>

        <button class="hidden md:flex items-center space-x-1 text-xs font-semibold tracking-wider text-gray-800 hover:text-black uppercase" type="button">
          <span>EYEGLASSES</span>
          <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </button>
      </div>

      <div class="flex-1 max-w-xl mx-2 hidden sm:block">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </div>
          <input class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-full text-xs placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-gray-800 focus:bg-white transition-colors" placeholder="Search Titan, Hexagonal, Round, Panto..." type="text">
        </div>
      </div>

      <div class="flex items-center space-x-4 sm:space-x-6 flex-shrink-0">

        <a class="flex flex-col items-center group relative text-gray-700 hover:text-black" href="#">
          <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">WISHLIST</span>
        </a>

        <a class="flex flex-col items-center group relative text-gray-700 hover:text-black" href="#">
          <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">CART</span>
        </a>

        <a class="flex flex-col items-center group text-gray-700 hover:text-black" href="#">
          <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">PROFILE</span>
        </a>

      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center px-4 py-12 sm:py-16">
    <div class="w-full max-w-[490px]">

      <section class="bg-white rounded-3xl p-7 sm:p-9 custom-shadow border border-[#eceae5]">

        <div class="text-center mb-6">
          <p class="text-[10px] tracking-[0.2em] font-medium uppercase text-brand-gold">
            CLIENT PORTAL • Secure Session
          </p>
          <h1 class="font-serif text-3xl sm:text-[34px] font-normal tracking-tight text-[#1c1b18] mt-2 mb-2.5">
            Welcome Back
          </h1>
          <p class="text-xs text-[#75736d] leading-relaxed max-w-[340px] mx-auto">
            Sign-in to consult your saved prescriptions, optical wishlist, and bespoke atelier appointments.
          </p>
        </div>


        <form action="#" class="space-y-4" method="POST">

          <div>
            <label class="block text-xs font-medium text-[#2d2c29] mb-1.5" for="email">
              Email Address
            </label>
            <div class="relative rounded-xl shadow-xs">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
              </div>
              <input class="block w-full pl-10 pr-10 py-2.5 bg-[#f5f4ef] border border-[#e5e3dc] rounded-xl text-xs sm:text-[13px] text-[#212120] font-medium focus:bg-white focus:ring-1 focus:ring-zinc-400 focus:border-zinc-400" id="email" name="email" type="email" required>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-medium text-[#2d2c29]" for="password">
                Password
              </label>
              <a class="text-[11px] font-medium text-brand-gold hover:text-brand-goldHover transition-colors" href="/forgot-password">
  Forgot Password?
</a>
            </div>

            <div class="relative rounded-xl shadow-xs">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
              </div>

              <input class="block w-full pl-10 pr-10 py-2.5 bg-[#f5f4ef] border border-[#e5e3dc] rounded-xl text-xs sm:text-[13px] text-[#212120] font-medium tracking-wide focus:bg-white focus:ring-1 focus:ring-zinc-400 focus:border-zinc-400" id="password" name="password" type="password" required>

              <button id="togglePassword" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-zinc-500 hover:text-zinc-800" type="button">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                  <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center">
              <input checked class="h-3.5 w-3.5 rounded border-zinc-300 text-brand-gold focus:ring-brand-gold cursor-pointer accent-[#a36528]" id="remember_me" name="remember_me" type="checkbox">
              <label class="ml-2 block text-[11px] text-[#5e5c57] cursor-pointer" for="remember_me">
                Remember this device for 30 days
              </label>
            </div>

            <div class="flex items-center space-x-1 text-[10px] text-zinc-500">
              <span>HIPAA / Rx Compliant</span>
            </div>
          </div>

          <div class="pt-2">
            <button class="w-full py-3 px-4 bg-[#161616] hover:bg-black text-white text-xs font-medium rounded-full shadow transition duration-200 flex items-center justify-center space-x-2 group" type="submit">
              <span>Sign In to MyFrames</span>
              <span class="text-zinc-400 group-hover:translate-x-0.5 transition-transform">→</span>
            </button>
          </div>

        </form>

        <div class="relative my-5">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-[#eae8e1]"></div>
          </div>
          <div class="relative flex justify-center text-[10px] uppercase">
            <span class="bg-white px-3 text-[#96948d] tracking-widest font-medium">OR CONTINUE WITH</span>
          </div>
        </div>

        <div>
          <button id="googleLoginBtn" class="w-full py-2.5 px-4 bg-[#f3f2ee] hover:bg-[#eae8e2] border border-[#e4e2da] rounded-full text-xs font-medium text-[#2d2c29] transition-all flex items-center justify-center space-x-2.5" type="button">

            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"></path>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"></path>
            </svg>

            <span>Continue with Google</span>
          </button>
        </div>

        <div class="mt-5 p-3.5 bg-[#f5f4ef] rounded-2xl text-center border border-[#e8e6df]">
          <p class="text-[11px] text-[#6d6b65]">
            Don't have a MyFrames Atelier profile yet?
          </p>
          <a class="mt-1 inline-block text-[11px] font-semibold text-brand-gold hover:text-brand-goldHover transition-colors" href="/signup">
            Create Account ↗
          </a>
        </div>

        <div class="mt-5 pt-3 border-t border-[#f0eee8] flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-[10px] text-[#8e8c85]">
          <span>256-bit SSL Encrypted</span>
          <span>•</span>
          <span>ISO 13485 Optical Lab Certified</span>
          <span>•</span>
          <span>Doctor's Rx Privacy Protected</span>
        </div>

      </section>
    </div>
  </main>

  <section class="w-full border-t border-[#e7e5de] bg-[#f8f7f2] py-9 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-[#2c2b27]">

      <div class="space-y-1.5">
        <h3 class="font-serif text-lg font-semibold tracking-tight text-[#171615]">
          Optical Prescription Assurance
        </h3>
        <p class="text-xs text-[#716f69] leading-relaxed">
          Every pair is meticulously calibrated to 0.01mm optical precision by licensed atelier optometrists. 100% digital lens accuracy guarantee.
        </p>
      </div>

      <div class="space-y-1.5">
        <h3 class="font-serif text-lg font-semibold tracking-tight text-[#171615]">
          Atelier Care &amp; Support
        </h3>
        <p class="text-xs text-[#716f69] leading-relaxed">
          Mon–Sat 9:00 to 20:00 EST. Complimentary frame adjustments, ultrasonic lens cleanings, and lifetime hinge service.
        </p>
      </div>

      <div class="space-y-1.5">
        <h3 class="font-serif text-lg font-semibold tracking-tight text-[#171615]">
          Bespoke Guarantee
        </h3>
        <p class="text-xs text-[#716f69] leading-relaxed">
          30-day home trial with complimentary returns, zero-hassle lens replacements, and certified prescription verification.
        </p>
      </div>

    </div>
  </section>

  <footer class="bg-[#070b13] text-gray-400 text-xs mt-14 border-t border-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">

        <div class="md:col-span-5 space-y-4">
          <div class="flex items-center space-x-3">
            <div class="w-7 h-7 rounded-full bg-amber-600 text-black flex items-center justify-center font-bold text-xs">
              TF
            </div>
            <div>
              <span class="font-serif font-bold text-sm tracking-tight text-white block">MyFrames Precision</span>
              <span class="text-[8px] tracking-[0.2em] uppercase font-semibold text-amber-500 block leading-tight">CERTIFIED OPHTHALMIC LABORATORY</span>
            </div>
          </div>

          <p class="text-xs text-gray-400 max-w-sm leading-relaxed">
            Medical-grade beta titanium and hand-carved cellulose acetate frames. Engineered with sub-millimeter precision in our certified optical research facility.
          </p>

          <div class="pt-2 text-[10px] space-y-1">
            <div class="flex items-center text-emerald-400 font-semibold tracking-wider uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-2"></span>
              SYSTEM STATUS: ALL LABS OPERATIONAL
            </div>
            <div class="text-gray-500 uppercase tracking-widest text-[9px]">
              ISO 13485 CERTIFIED
            </div>
          </div>
        </div>

        <div class="md:col-span-2 space-y-3">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-white">LAB ENGINEERING</h4>
          <ul class="space-y-2 text-xs text-gray-400">
            <li><a class="hover:text-white transition-colors" href="#">0.01mm Laser Precision</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Refractive Index Profiling</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Laser Axis Calibration</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Digital Free-Form Surfacing</a></li>
          </ul>
        </div>

        <div class="md:col-span-2 space-y-3">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-white">CUSTOMER SUPPORT</h4>
          <ul class="space-y-2 text-xs text-gray-400">
            <li><a class="hover:text-white transition-colors" href="#">Optometrist Video Consultation</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Eyeglasses Fit Guarantee</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Complimentary Frame Adjustments</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Order Tracking &amp; Telemetry</a></li>
            <li><a class="hover:text-white transition-colors" href="#">Titan Optical Lab Network</a></li>
          </ul>
        </div>

        <div class="md:col-span-3 space-y-3">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-white">OPTICAL JOURNAL</h4>
          <p class="text-[11px] text-gray-400 leading-snug">
            Subscribe to receive laboratory dispatch notes, lens tech whitepapers, and seasonal catalog releases.
          </p>
          <form class="flex items-center gap-1.5 pt-1" onsubmit="event.preventDefault();">
            <input class="bg-gray-900 border border-gray-800 text-xs px-3 py-2 rounded text-gray-200 placeholder-gray-600 focus:outline-none focus:border-amber-500 w-full" placeholder="Enter laboratory email" type="email">
            <button class="bg-amber-600 hover:bg-amber-500 text-black font-bold uppercase text-[10px] tracking-wider px-3 py-2 rounded transition-colors" type="submit">
              JOIN
            </button>
          </form>
        </div>

      </div>

      <div class="mt-12 pt-6 border-t border-gray-900 flex flex-wrap justify-between items-center text-[10px] text-gray-500 gap-4">
        <div>
          © 2025 TF MyFrames Precision Optics. All rights reserved.
        </div>
        <div class="flex items-center space-x-6">
          <a class="hover:text-gray-400 transition-colors" href="#">Medical Privacy &amp; HIPAA</a>
          <a class="hover:text-gray-400 transition-colors" href="#">Terms of Bespoke Service</a>
          <a class="hover:text-gray-400 transition-colors" href="#">Laboratory Standards</a>
        </div>
      </div>

    </div>
  </footer>

  <script>
    document.getElementById("googleLoginBtn").addEventListener("click", () => {
      window.location.href = "/api/users/google";
    });
  </script>

  <script src="/js/login.js"></script>

</body>
</html>
