
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyFrames - Edit Profile</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .font-serif-display {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }

    .font-mono-tech {
      font-family: 'JetBrains Mono', monospace;
    }
  </style>
</head>

<body class="bg-[#FAFAFA] text-[#1E242D] min-h-screen flex flex-col">

  <!-- Announcement Bar -->
  <div class="bg-[#090D14] text-[#8E9CAE] text-[10px] font-mono-tech uppercase tracking-wider py-2 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between gap-2">
      <div>
        <span class="text-gray-300">Titan Optical Lab</span>
        <span class="text-gray-600 mx-2">|</span>
        Certified Precision Optics
      </div>
      <div>Free Shipping US & India</div>
    </div>
  </div>

  <!-- Navbar -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between gap-6">

      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#111622] text-white flex items-center justify-center font-serif-display font-bold text-xl">
          TF
        </div>

        <div class="flex flex-col">
          <span class="font-serif-display font-bold text-2xl text-[#121722]">MyFrames</span>
          <span class="text-[9px] font-mono-tech tracking-[0.25em] text-gray-400 uppercase">
            Precision Optics
          </span>
        </div>
      </a>

      <nav class="hidden md:flex">
        <a href="/" class="text-xs font-semibold uppercase tracking-wider text-gray-700 hover:text-black">
          Eyeglasses
        </a>
      </nav>

      <div class="flex items-center gap-6">
        <a href="/profile" class="flex flex-col items-center text-gray-700 hover:text-black">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
          </svg>
          <span class="text-[10px] uppercase font-semibold mt-1">Profile</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-8 py-8 w-full flex-1">

    <!-- Back Navigation -->
    <div class="pb-6 border-b border-gray-100">
      <a href="/personal-info"
        class="inline-flex items-center text-[10px] font-mono-tech tracking-wider uppercase font-semibold text-gray-600 hover:text-black">
        ← Back to Personal Information
      </a>
    </div>

    <!-- Page Heading -->
    <div class="pt-6 pb-8">
      <h1 class="font-serif-display text-4xl sm:text-5xl font-medium text-gray-900">
        Edit Profile
      </h1>

      <p class="text-xs text-gray-500 mt-2 max-w-2xl font-light">
        Update your personal information and contact details.
      </p>
    </div>

    <!-- Profile Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Profile Card -->
      <section class="lg:col-span-4 bg-white rounded-3xl p-8 border border-gray-100 shadow-sm flex flex-col items-center text-center">

        <!-- Profile Image -->
        <div class="relative mt-2 mb-5">
          <div class="w-36 h-36 rounded-full bg-[#E3E4E8] flex items-center justify-center overflow-hidden border-4 border-white shadow-inner">

            <% if (user.profilePhoto) { %>
              <img
                src="<%= user.profilePhoto %>"
                alt="Profile Picture"
                class="w-full h-full object-cover"
              >
            <% } else { %>
              <svg class="w-20 h-20 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            <% } %>

          </div>
        </div>

        <!-- User Name -->
        <h2 class="font-serif-display text-2xl font-semibold text-gray-900">
          <%= user.name %>
        </h2>

        <!-- Email Verification -->
        <div class="mt-2 text-xs text-amber-700">
          <% if (user.isEmailVerified) { %>
            <span>✓ Email Verified</span>
          <% } else { %>
            <span>Email Not Verified</span>
          <% } %>
        </div>

        <!-- Account Status -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium bg-[#F9F5EC] text-[#935B27] border border-[#EFE3CF] mt-4 mb-6">
          <span class="w-1.5 h-1.5 rounded-full <%= user.isBlocked ? 'bg-red-500' : 'bg-[#935B27]' %>"></span>
          <span><%= user.isBlocked ? 'Account Blocked' : 'Account Active' %></span>
        </div>

        <p class="text-[10px] text-gray-400 mt-2 leading-normal max-w-[220px]">
          Your profile picture can be updated from your account settings.
        </p>

      </section>

      <!-- Right Edit Form -->
      <section class="lg:col-span-8 bg-white rounded-3xl p-7 sm:p-10 border border-gray-100 shadow-sm">

        <form
          id="edit-profile-form"
          action="/api/users/update-profile"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-6"
        >

          <!-- Form Heading -->
          <div class="flex items-start justify-between pb-3 border-b border-gray-100">
            <div>
              <h2 class="font-serif-display text-2xl font-bold text-gray-900">
                Personal Credentials
              </h2>

              <p class="text-xs text-gray-500 mt-1">
                Update your personal information.
              </p>
            </div>

            <span class="text-[11px] font-mono-tech text-red-500 uppercase">
              * Required
            </span>
          </div>

          <!-- Profile Photo Upload -->
          <div class="space-y-2">
            <label for="profilePhoto" class="text-xs font-mono-tech font-bold uppercase tracking-wider text-gray-700">
              Profile Photo
            </label>

            <div class="rounded-2xl bg-[#F4F5F7] border border-transparent px-4 py-4">
              <input
                id="profilePhoto"
                name="profilePhoto"
                type="file"
                accept="image/*"
                class="w-full text-sm text-gray-700"
              >

              <p class="text-[10px] text-gray-400 mt-2">
                Select an image to update your profile picture. Maximum file size: 2 MB.
              </p>
            </div>
          </div>

          <!-- Remove Profile Photo -->
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input
              id="removeProfilePhoto"
              type="checkbox"
              name="removeProfilePhoto"
              value="true"
              class="rounded border-gray-300"
            >
            Remove profile photo
          </label>

          <!-- Full Name -->
          <div class="space-y-2">
            <label for="name" class="text-xs font-mono-tech font-bold uppercase tracking-wider text-gray-700">
              Full Name <span class="text-red-500">*</span>
            </label>

            <div class="rounded-2xl bg-[#F4F5F7] border border-transparent focus-within:border-gray-300 flex items-center px-4 py-3">
              <input
                id="name"
                name="name"
                type="text"
                value="<%= user.name %>"
                required
                class="w-full bg-transparent border-none p-0 text-sm font-medium text-gray-800 focus:ring-0"
              >
            </div>
          </div>

          <!-- Email -->
          <div class="space-y-2">

            <div class="flex justify-between items-center">
              <label for="email" class="text-xs font-mono-tech font-bold uppercase tracking-wider text-gray-700">
                Primary Email Address
              </label>

              <span class="text-[10px] text-amber-700 font-semibold">
                🔒 SECURED
              </span>
            </div>

            <div class="flex flex-col sm:flex-row gap-2">

              <div class="flex-1 rounded-2xl bg-[#F4F5F7] flex items-center px-4 py-3">
                <input
                  id="email"
                  type="email"
                  value="<%= user.email %>"
                  readonly
                  class="w-full bg-transparent border-none p-0 text-sm font-medium text-gray-700 focus:ring-0 cursor-not-allowed"
                >
              </div>

              <button
                type="button"
                id="changeEmailBtn"
                class="px-4 py-3 rounded-2xl bg-[#D6E0EA] hover:bg-[#c9d5e2] text-[#2C4156] font-mono-tech text-[11px] font-bold uppercase tracking-wider"
              >
                Change Email
              </button>

            </div>

            <p class="text-[10px] text-gray-400 pl-1">
              Changing your email requires OTP verification.
            </p>

            <!-- Change Email Section -->
            <div id="emailChangeSection" class="hidden mt-4 p-5 rounded-2xl bg-[#F4F5F7] space-y-4">

              <!-- New Email Input -->
              <div id="newEmailSection" class="space-y-3">

                <label for="newEmail" class="text-xs font-semibold text-gray-700">
                  Enter New Email Address
                </label>

                <input
                  id="newEmail"
                  type="email"
                  placeholder="Enter your new email"
                  class="w-full rounded-xl border-gray-200 text-sm"
                >

                <button
                  type="button"
                  id="sendEmailOtpBtn"
                  class="px-5 py-2.5 rounded-xl bg-[#1F2530] text-white text-xs font-bold"
                >
                  Send OTP
                </button>

              </div>

              <!-- OTP Input -->
              <div id="emailOtpSection" class="hidden space-y-3">

                <label class="text-xs font-semibold text-gray-700">
                  Enter the 6-digit OTP
                </label>

                <div class="flex gap-2">
                  <% for (let i = 0; i < 6; i++) { %>
                    <input
                      type="text"
                      maxlength="1"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      class="email-otp w-10 h-11 text-center rounded-lg border-gray-300 text-lg font-semibold"
                    >
                  <% } %>
                </div>

                <p class="text-xs text-gray-600">
                  OTP expires in:
                  <span id="emailOtpTimer" class="font-bold text-red-600">05:00</span>
                </p>

                <button
                  type="button"
                  id="resendEmailOtpBtn"
                  class="hidden text-xs font-bold text-blue-700 underline"
                >
                  Resend OTP
                </button>

                <button
                  type="button"
                  id="verifyEmailOtpBtn"
                  class="px-5 py-2.5 rounded-xl bg-[#1F2530] text-white text-xs font-bold"
                >
                  Verify OTP
                </button>

              </div>

              <p id="emailChangeMessage" class="text-xs"></p>

            </div>

          </div>

          <!-- Mobile and DOB -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

            <!-- Phone -->
            <div class="space-y-2">
              <label for="phone" class="text-xs font-mono-tech font-bold uppercase tracking-wider text-gray-700">
                Mobile Contact <span class="text-red-500">*</span>
              </label>

              <div class="rounded-2xl bg-[#F4F5F7] flex items-center px-4 py-3">
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  value="<%= user.phone || '' %>"
                  required
                  class="w-full bg-transparent border-none p-0 text-sm font-medium text-gray-800 focus:ring-0"
                >
              </div>
            </div>

            <!-- DOB -->
            <div class="space-y-2">
              <label for="dateOfBirth" class="text-xs font-mono-tech font-bold uppercase tracking-wider text-gray-700">
                Date of Birth
              </label>

              <div class="rounded-2xl bg-[#F4F5F7] flex items-center px-4 py-3">
                <input
                  id="dateOfBirth"
                  name="dateOfBirth"
                  type="date"
                  value="<%= user.dateOfBirth && !isNaN(new Date(user.dateOfBirth).getTime()) ? new Date(user.dateOfBirth).toISOString().split('T')[0] : '' %>"
                  class="w-full bg-transparent border-none p-0 text-sm font-medium text-gray-800 focus:ring-0"
                >
              </div>
            </div>

          </div>

          <!-- Gender -->
          <div class="space-y-2">
            <label for="gender" class="text-xs font-mono-tech font-bold uppercase tracking-wider text-gray-700">
              Gender Identity
            </label>

            <div class="rounded-2xl bg-[#F4F5F7] flex items-center px-4 py-3">
              <select
                id="gender"
                name="gender"
                class="w-full bg-transparent border-none p-0 text-sm font-medium text-gray-800 focus:ring-0"
              >
                <option value="">Select Gender</option>

                <option value="Female" <%= user.gender === "Female" ? "selected" : "" %>>
                  Female
                </option>

                <option value="Male" <%= user.gender === "Male" ? "selected" : "" %>>
                  Male
                </option>

                <option value="Non-Binary" <%= user.gender === "Non-Binary" ? "selected" : "" %>>
                  Non-Binary
                </option>

                <option value="Prefer not to say" <%= user.gender === "Prefer not to say" ? "selected" : "" %>>
                  Prefer not to say
                </option>
              </select>
            </div>
          </div>

          <!-- Form Message -->
          <p id="profileMessage" class="text-sm"></p>

          <!-- Form Buttons -->
          <div class="flex items-center justify-end gap-3 pt-4">

            <a
              href="/personal-info"
              class="px-6 py-2.5 rounded-full bg-[#E8EAEF] hover:bg-[#dcdee4] text-[#333C48] text-xs font-mono-tech uppercase font-bold tracking-wider"
            >
              Cancel
            </a>

            <button
              id="saveProfileBtn"
              type="submit"
              class="px-6 py-2.5 rounded-full bg-[#1F2530] hover:bg-black text-white text-xs font-mono-tech uppercase font-bold tracking-wider flex items-center gap-2 shadow-md"
            >
              <span class="text-amber-500">✓</span>
              <span>Save Changes</span>
            </button>

          </div>

        </form>

      </section>

    </div>

  </main>

  <!-- Footer -->
  <footer class="bg-[#0b0e14] text-gray-300 text-xs pt-12 pb-6 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">

      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-10 border-b border-gray-800">

        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="font-serif text-lg font-bold tracking-tight text-white">TF MyFrames</span>
          </div>

          <p class="text-gray-400 text-[11px] leading-relaxed mb-5 font-normal">
            Medical-grade titanium and hand-carved cellulose acetate frames. Engineered with sub-millimeter precision in our certified optical research facility.
          </p>

          <div class="flex flex-col gap-2 items-start">
            <span class="text-[9px] uppercase tracking-widest text-gray-400 border border-gray-800 rounded px-2.5 py-1 bg-gray-900/60 font-mono">ISO 13485 CERTIFIED</span>
            <span class="text-[9px] uppercase tracking-widest text-gray-400 border border-gray-800 rounded px-2.5 py-1 bg-gray-900/60 font-mono">CLASS 1 MEDICAL DEVICE</span>
          </div>
        </div>

        <div>
          <h4 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4 font-mono">Lab Engineering</h4>
          <ul class="space-y-2.5 text-[11px] text-gray-400">
            <li><a class="hover:text-white transition" href="#">Ti-B11 Beta Titanium</a></li>
            <li><a class="hover:text-white transition" href="#">Refractive Index Profiling</a></li>
            <li><a class="hover:text-white transition" href="#">Laser Axis Calibration</a></li>
            <li><a class="hover:text-white transition" href="#">Digital Free-Form Surfacing</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4 font-mono">Customer Support</h4>
          <ul class="space-y-2.5 text-[11px] text-gray-400">
            <li><a class="hover:text-white transition" href="#">Optometrist Video Consultation</a></li>
            <li><a class="hover:text-white transition" href="#">Pupillary Distance Tool</a></li>
            <li><a class="hover:text-white transition" href="#">International Freight &amp; Duties</a></li>
            <li><a class="hover:text-white transition" href="#">Atelier Warranty &amp; Tune-ups</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-4 font-mono">Optical Journal</h4>

          <p class="text-gray-400 text-[11px] leading-relaxed mb-3">
            Receive monograph updates on ophthalmic engineering and bespoke frame silhouettes.
          </p>

          <form class="flex items-center" onsubmit="event.preventDefault();">
            <input class="w-full bg-[#151922] border border-gray-800 rounded-l px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-amber-600 focus:ring-0" placeholder="optics@atelier.com" type="email">

            <button class="bg-[#d97706] hover:bg-[#b45309] text-white font-bold text-xs uppercase px-4 py-2 rounded-r transition tracking-wider" type="submit">
              Join
            </button>
          </form>
        </div>

      </div>

      <div class="pt-6 flex flex-col md:flex-row justify-between items-center gap-3 text-[10px] text-gray-500">
        <div>© 2025 TF MyFrames Precision Optics. All rights reserved.</div>

        <div class="flex items-center gap-6">
          <a class="hover:text-gray-400 transition" href="#">Medical Privacy &amp; HIPAA</a>
          <a class="hover:text-gray-400 transition" href="#">Terms of Bespoke Service</a>
          <a class="hover:text-gray-400 transition" href="#">Laboratory Standards</a>
        </div>
      </div>

    </div>
  </footer>

  <!-- JavaScript -->
  <script>

    // =====================================
    // Profile Update
    // =====================================

    const profileForm = document.getElementById("edit-profile-form");
    const profileMessage = document.getElementById("profileMessage");
    const saveProfileBtn = document.getElementById("saveProfileBtn");

    profileForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(profileForm);

      try {
        saveProfileBtn.disabled = true;
        saveProfileBtn.textContent = "Saving...";

        const response = await fetch("/api/users/update-profile", {
          method: "POST",
          body: formData,
          credentials: "same-origin"
        });

        const data = await response.json();

        if (response.ok && data.success) {
          profileMessage.textContent =
            data.message || "Profile updated successfully.";

          profileMessage.className = "text-sm text-green-600";

          setTimeout(() => {
            window.location.href = "/personal-info";
          }, 1000);

        } else {
          profileMessage.textContent =
            data.message || "Unable to update profile.";

          profileMessage.className = "text-sm text-red-600";
        }

      } catch (error) {
        console.error("Update profile error:", error);

        profileMessage.textContent =
          "Something went wrong. Please try again.";

        profileMessage.className = "text-sm text-red-600";

      } finally {
        saveProfileBtn.disabled = false;
        saveProfileBtn.innerHTML =
          '<span class="text-amber-500">✓</span><span>Save Changes</span>';
      }
    });


    // =====================================
    // Email Change Elements
    // =====================================

    const changeEmailBtn = document.getElementById("changeEmailBtn");
    const emailChangeSection = document.getElementById("emailChangeSection");
    const newEmailSection = document.getElementById("newEmailSection");
    const emailOtpSection = document.getElementById("emailOtpSection");

    const newEmailInput = document.getElementById("newEmail");
    const sendOtpBtn = document.getElementById("sendEmailOtpBtn");
    const verifyOtpBtn = document.getElementById("verifyEmailOtpBtn");
    const resendOtpBtn = document.getElementById("resendEmailOtpBtn");

    const otpInputs = document.querySelectorAll(".email-otp");
    const emailChangeMessage = document.getElementById("emailChangeMessage");
    const emailInput = document.getElementById("email");
    const emailOtpTimer = document.getElementById("emailOtpTimer");

    let emailOtpCountdown;
    let emailResendCountdown;


    // =====================================
    // Show / Hide Email Change Section
    // =====================================

    changeEmailBtn.addEventListener("click", () => {
      emailChangeSection.classList.toggle("hidden");
    });


    // =====================================
    // Display Email Messages
    // =====================================

    function showEmailMessage(text, type = "success") {
      emailChangeMessage.textContent = text;

      emailChangeMessage.className = type === "success"
        ? "text-xs text-green-600"
        : "text-xs text-red-600";
    }


    // =====================================
    // Clear OTP Inputs
    // =====================================

    function clearOtpInputs() {
      otpInputs.forEach(input => {
        input.value = "";
      });
    }


    // =====================================
    // OTP Expiry Timer
    // =====================================

    function startEmailOtpTimer() {
      clearInterval(emailOtpCountdown);

      let remainingSeconds = 300;

      function updateTimer() {
        const minutes = Math.floor(remainingSeconds / 60);
        const seconds = remainingSeconds % 60;

        emailOtpTimer.textContent =
          String(minutes).padStart(2, "0") +
          ":" +
          String(seconds).padStart(2, "0");

        if (remainingSeconds <= 0) {
          clearInterval(emailOtpCountdown);
          emailOtpTimer.textContent = "Expired";
          return;
        }

        remainingSeconds--;
      }

      updateTimer();

      emailOtpCountdown = setInterval(updateTimer, 1000);
    }


    // =====================================
    // Resend OTP Timer
    // =====================================

    function startEmailResendTimer() {
      clearInterval(emailResendCountdown);

      resendOtpBtn.classList.add("hidden");

      let remainingSeconds = 30;

      emailResendCountdown = setInterval(() => {
        remainingSeconds--;

        if (remainingSeconds <= 0) {
          clearInterval(emailResendCountdown);
          resendOtpBtn.classList.remove("hidden");
        }
      }, 1000);
    }


    // =====================================
    // OTP Input Navigation
    // =====================================

    otpInputs.forEach((input, index) => {

      input.addEventListener("input", () => {
        input.value = input.value.replace(/\D/g, "").slice(0, 1);

        if (input.value && index < 5) {
          otpInputs[index + 1].focus();
        }
      });

      input.addEventListener("keydown", (event) => {
        if (
          event.key === "Backspace" &&
          !input.value &&
          index > 0
        ) {
          otpInputs[index - 1].focus();
        }
      });

    });


    // =====================================
    // Send Email OTP
    // =====================================

    sendOtpBtn.addEventListener("click", async () => {

      const newEmail = newEmailInput.value.trim();

      if (!newEmail) {
        showEmailMessage("Please enter your new email address.", "error");
        return;
      }

      if (!newEmailInput.checkValidity()) {
        showEmailMessage("Please enter a valid email address.", "error");
        return;
      }

      if (newEmail.toLowerCase() === emailInput.value.trim().toLowerCase()) {
        showEmailMessage("This is already your current email address.", "error");
        return;
      }

      try {
        sendOtpBtn.disabled = true;
        sendOtpBtn.textContent = "Sending...";

        const response = await fetch("/api/users/change-email", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          credentials: "same-origin",
          body: JSON.stringify({ newEmail })
        });

        const data = await response.json();

        if (response.ok && data.success) {

          showEmailMessage(
            data.message || "OTP sent successfully to your new email address."
          );

          newEmailSection.classList.add("hidden");
          emailOtpSection.classList.remove("hidden");

          clearOtpInputs();

          startEmailOtpTimer();
          startEmailResendTimer();

          otpInputs[0].focus();

        } else {

          showEmailMessage(data.message || "Unable to send OTP.", "error");

        }

      } catch (error) {

        console.error("Send email OTP error:", error);
        showEmailMessage("Something went wrong. Please try again.", "error");

      } finally {

        sendOtpBtn.disabled = false;
        sendOtpBtn.textContent = "Send OTP";

      }

    });


    // =====================================
    // Resend Email OTP
    // =====================================

    resendOtpBtn.addEventListener("click", async () => {

      try {
        resendOtpBtn.disabled = true;
        resendOtpBtn.textContent = "Sending...";

        const response = await fetch("/api/users/resend-email-change-otp", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          credentials: "same-origin"
        });

        const data = await response.json();

        if (response.ok && data.success) {

          showEmailMessage(
            data.message || "A new OTP has been sent to your email address."
          );

          clearOtpInputs();

          startEmailOtpTimer();
          startEmailResendTimer();

          otpInputs[0].focus();

        } else {

          showEmailMessage(data.message || "Unable to resend OTP.", "error");

          resendOtpBtn.classList.remove("hidden");

        }

      } catch (error) {

        console.error("Resend email OTP error:", error);

        showEmailMessage("Something went wrong. Please try again.", "error");

        resendOtpBtn.classList.remove("hidden");

      } finally {

        resendOtpBtn.disabled = false;
        resendOtpBtn.textContent = "Resend OTP";

      }

    });


    // =====================================
    // Verify Email OTP
    // =====================================

    verifyOtpBtn.addEventListener("click", async () => {

      const otp = Array.from(otpInputs)
        .map(input => input.value)
        .join("");

      if (otp.length !== 6) {
        showEmailMessage("Please enter all 6 OTP digits.", "error");
        return;
      }

      try {
        verifyOtpBtn.disabled = true;
        verifyOtpBtn.textContent = "Verifying...";

        const response = await fetch("/api/users/verify-email-change-otp", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          credentials: "same-origin",
          body: JSON.stringify({ otp })
        });

        const data = await response.json();

        if (response.ok && data.success) {

          showEmailMessage(
            data.message || "Email address updated successfully."
          );

          clearInterval(emailOtpCountdown);
          clearInterval(emailResendCountdown);

          resendOtpBtn.classList.add("hidden");

          emailInput.value = newEmailInput.value.trim();

          clearOtpInputs();

          setTimeout(() => {
            window.location.reload();
          }, 1000);

        } else {

          showEmailMessage(data.message || "Invalid or expired OTP.", "error");

        }

      } catch (error) {

        console.error("Verify email OTP error:", error);

        showEmailMessage("Something went wrong. Please try again.", "error");

      } finally {

        verifyOtpBtn.disabled = false;
        verifyOtpBtn.textContent = "Verify OTP";

      }

    });

  </script>

</body>
</html>
