<script>
  const editAddressForm = document.getElementById("edit-address-form");
  const addressMessage = document.getElementById("address-message");
  const saveAddressBtn = document.getElementById("save-address-btn");

  editAddressForm.addEventListener("submit", async function (event) {
    event.preventDefault();

    addressMessage.textContent = "";
    saveAddressBtn.disabled = true;
    saveAddressBtn.textContent = "Saving...";

    try {
      const formData = new FormData(editAddressForm);
      const addressData = Object.fromEntries(formData.entries());

      const response = await fetch(
        "/api/users/edit-address/<%= address._id %>",
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json"
          },
          credentials: "same-origin",
          body: JSON.stringify(addressData)
        }
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Unable to update address.");
      }

      addressMessage.textContent = "Address updated successfully!";
      addressMessage.className = "text-sm font-medium text-green-600";

      window.location.href = "/addresses";

    } catch (error) {
      addressMessage.textContent = error.message;
      addressMessage.className = "text-sm font-medium text-red-600";

      saveAddressBtn.disabled = false;
      saveAddressBtn.textContent = "Save Changes";
    }
  });
</script>
