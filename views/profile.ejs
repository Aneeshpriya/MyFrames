
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Account Profile | MyFrames Precision Optics</title>

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">

<script>
tailwind.config = {
  theme: {
    extend: {
      fontFamily: {
        sans: ['Inter', 'sans-serif'],
        serif: ['Cinzel', 'serif']
      },
      colors: {
        brand: {
          gold: '#c27803',
          dark: '#111317',
          navy: '#0b0f19',
          lightslate: '#f8fafc'
        }
      }
    }
  }
}
</script>

<style>
.tracking-widest-plus {
  letter-spacing: 0.18em;
}
</style>
</head>

<body class="bg-[#f4f5f7] text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">

<!-- Announcement Bar -->
<div class="bg-[#0e1118] text-[#a0a7b5] text-[10.5px] uppercase tracking-wider py-2 px-4 md:px-8 border-b border-gray-800">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 font-medium">
    <div class="flex items-center gap-2 flex-wrap justify-center sm:justify-start">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span class="text-gray-300 font-semibold">Titan Optical Lab</span>
      <span class="text-gray-600">|</span>
      <span>Certified • Tolerance ±0.01mm</span>
      <span class="text-gray-600">|</span>
      <span class="text-gray-200">Complimentary 1.60 High-Index Lenses</span>
    </div>

    <div class="flex items-center gap-3 text-gray-400 text-[10px]">
      <span>Free Shipping US &amp; India</span>
      <span class="text-gray-600">•</span>
      <span class="tracking-widest">ISO 13485 ACCREDITED</span>
    </div>
  </div>
</div>

<!-- Main Header -->
<header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-3.5 flex items-center justify-between gap-6">

    <div class="flex items-center gap-8 shrink-0">
      <a class="flex items-center gap-2.5 group" href="/">
        <div class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center font-bold text-xs tracking-tighter">
          TF
        </div>
        <div>
          <span class="font-bold text-base tracking-tight text-gray-950 block leading-tight">MyFrames</span>
          <span class="text-[8px] uppercase tracking-widest-plus text-gray-500 font-semibold block">Precision Optics</span>
        </div>
      </a>

      <button class="hidden md:flex items-center gap-1.5 text-xs font-semibold tracking-wider text-gray-800 hover:text-black uppercase" type="button">
        Eyeglasses
        <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </button>
    </div>

    <div class="flex-1 max-w-xl mx-2 hidden sm:block">
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </span>
        <input class="w-full text-xs pl-9 pr-4 py-2.5 bg-[#f5f6f8] border-none rounded-full placeholder-gray-400 focus:bg-white focus:ring-1 focus:ring-gray-400 focus:outline-none transition-all" placeholder="Search Titan, Hexagonal, Round, Panto..." type="text">
      </div>
    </div>

    <div class="flex items-center gap-6 shrink-0">

      <a class="relative flex flex-col items-center group" href="#">
        <div class="relative">
          <svg class="w-5 h-5 text-gray-700 group-hover:text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="absolute -top-1.5 -right-2 bg-rose-500 text-white text-[9px] font-bold w-3.5 h-3.5 rounded-full flex items-center justify-center">0</span>
        </div>
        <span class="text-[9px] uppercase font-bold text-gray-600 mt-1">Wishlist</span>
      </a>
<a class="flex flex-col items-center group relative text-gray-700 hover:text-black" href="#">
          <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          <span class="text-[9px] font-medium tracking-tight text-gray-500 mt-0.5">CART</span>
        </a>

      <a class="flex flex-col items-center text-black font-semibold" href="/profile">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
        </svg>
        <span class="text-[9px] uppercase tracking-wider font-bold mt-1 text-gray-900">Profile</span>
      </a>

    </div>
  </div>
</header>

<!-- Main Content -->
<main class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 flex-grow">

  <!-- Breadcrumb -->
  <nav class="text-[11px] font-bold tracking-wider uppercase mb-5 text-gray-400 flex items-center gap-2">
    <a class="hover:text-gray-700 transition" href="/">Home</a>
    <span>/</span>
    <a class="hover:text-gray-700 transition" href="/profile">Account</a>
    <span>/</span>
    <span class="text-[#b25e01]">My Profile</span>
  </nav>

  <!-- Profile Header Card -->
  <section class="bg-white rounded-xl border border-gray-100 p-6 md:p-7 mb-6 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.04)] flex items-center gap-5">

    <div class="relative">

      <% if (user.profilePhoto) { %>

        <img
          src="<%= user.profilePhoto %>"
          alt="Profile Photo"
          class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border border-gray-200 ring-2 ring-gray-100 shadow-sm shrink-0"
        >

      <% } else { %>

        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#f1f5f9] border border-gray-200 flex items-center justify-center text-slate-600 ring-2 ring-gray-100 shadow-sm shrink-0">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
          </svg>
        </div>

      <% } %>

    </div>

    <div class="min-w-0">

      <p class="text-[10px] uppercase tracking-widest text-gray-400 font-semibold mb-1">
        Welcome back
      </p>

      <h2 class="text-xl sm:text-2xl font-bold text-gray-900">
        <%= user.name %>
      </h2>

      <p class="text-xs text-gray-500 mt-1">
        <%= user.email %>
      </p>

      <% if (user.phone) { %>
        <p class="text-xs text-gray-500 mt-1">
          <%= user.phone %>
        </p>
      <% } %>

    </div>

  </section>

  <!-- Dashboard Services Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

    <!-- Card 1: Personal Information -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-indigo-200 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-blue-500 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-100/80 flex items-center justify-center text-indigo-600 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-100 font-mono">Telemetry</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-indigo-950 transition-colors">Personal Info</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          View and update your personal details, including name, email address, and phone number.
        </p>
      </div>
      <div class="mt-4 flex justify-end">
  <a href="/edit-profile"
     class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors">
    Manage <span>→</span>
  </a>
</div>
    </article>

    <!-- Card 2: My Orders -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-amber-200 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-400 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-100/80 flex items-center justify-center text-amber-600 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200/80 font-medium">2 Orders</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-amber-950 transition-colors">My Orders</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          Track ophthalmic shipments, view tax invoices, and manage returns.
        </p>
      </div>
      <div class="mt-4 flex justify-end">
        <button class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors" type="button">
          View <span>→</span>
        </button>
      </div>
    </article>

    <!-- Card 3: My Wallet -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-emerald-200 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-100/80 flex items-center justify-center text-emerald-600 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200/80 font-medium">₹1,250 Balance</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-emerald-950 transition-colors">My Wallet</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          Apply store credits, optical cashback rewards, and refund reserves.
        </p>
      </div>
      <div class="mt-4 flex justify-end">
        <button class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors" type="button">
          Wallet <span>→</span>
        </button>
      </div>
    </article>

    <!-- Card 4: Coupons & Offers -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-purple-200 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-purple-500 to-indigo-500 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-purple-50 border border-purple-100/80 flex items-center justify-center text-purple-600 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-purple-50 text-purple-800 border border-purple-200/80 font-medium">3 Active</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-purple-950 transition-colors">Coupons &amp; Offers</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          Promotional promo codes, order privileges, and complimentary coatings.
        </p>
      </div>
      <div class="mt-4 flex justify-end">
        <button class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors" type="button">
          Offers <span>→</span>
        </button>
      </div>
    </article>

    <!-- Card 5: My Addresses -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-teal-200 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-teal-50 border border-teal-100/80 flex items-center justify-center text-teal-600 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-teal-50 text-teal-800 border border-teal-200/80 font-medium">2 Saved</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-teal-950 transition-colors">My Addresses</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          Manage home and clinic delivery coordinates and default dispatch paths.
        </p>
      </div>
     <div class="mt-4 flex justify-end">
  <a
    href="/addresses"
    class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors"
  >
    Manage <span>→</span>
  </a>
</div>
    </article>

    <!-- Card 6: Login & Security -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-slate-300 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-slate-600 to-slate-400 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-700 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 0">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 font-medium">Active 2FA</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-slate-950 transition-colors">Login &amp; Security</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          Manage your password, email verification, and Google account connection.
        </p>
      </div>
      <div class="mt-4 flex justify-end">
        <button class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors" type="button">
          Security <span>→</span>
        </button>
      </div>
    </article>

    <!-- Card 7: My Wishlist -->
    <article class="bg-white rounded-xl border border-gray-100 hover:border-rose-200 hover:shadow-md p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col justify-between transition-all relative overflow-hidden group min-h-[220px]">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-rose-500 to-pink-500 opacity-80"></div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-9 h-9 rounded-xl bg-rose-50 border border-rose-100/80 flex items-center justify-center text-rose-600 shadow-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
            </svg>
          </div>
          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200/80 font-medium">4 Saved</span>
        </div>
        <h2 class="text-sm font-bold text-gray-900 mb-1 group-hover:text-rose-950 transition-colors">My Wishlist</h2>
        <p class="text-xs text-gray-500 leading-relaxed font-normal">
          Saved titanium optical silhouettes, bespoke tints, and prescription drafts.
        </p>
      </div>
      <div class="mt-4 flex justify-end">
        <button class="inline-flex items-center gap-1.5 bg-[#171a20] hover:bg-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full transition-colors" type="button">
          Wishlist <span>→</span>
        </button>
      </div>
    </article>

    <!-- Card 8: Prescriptions & Lab Data -->
    <!-- Keep your prescription card here when you add its design. -->

  </div>

  <!-- Logout Section --><!-- Logout Section -->
<section class="bg-white rounded-xl border border-gray-100 p-5 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.04)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">

  <div class="flex items-center gap-4">
    <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-500 shrink-0">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
    </div>

    <div>
      <h3 class="text-sm font-bold text-gray-900">Logout</h3>
      <p class="text-xs text-gray-500">
        Securely sign out of your MyFrames optical account session across this device.
      </p>
    </div>
  </div>

  <button
    id="logoutBtn"
    type="button"
    class="border border-rose-200 text-rose-600 bg-rose-50/50 hover:bg-rose-100 text-xs font-bold uppercase tracking-wider px-5 py-2.5 rounded-full transition shrink-0">
    Logout
  </button>

</section>

</main>

<!-- Footer -->
<footer class="bg-[#0b0e14] text-gray-300 text-xs pt-12 pb-6 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-10 border-b border-gray-800">

      <div>
        <div class="flex items-center gap-2 mb-3">
