
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personal Information - MyFrames</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              navy: '#0c121e',
              dark: '#080d17',
              charcoal: '#18202f',
              copper: '#c36a2d',
              terracotta: '#c85a17',
              accent: '#bd5319'
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style>
    .font-serif-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
  </style>
</head>

<body class="bg-[#f8f9fb] text-slate-800 font-sans antialiased min-h-screen flex flex-col">

  <!-- Announcement Bar -->
  <aside class="bg-[#0b101b] text-[#9ba3af] text-[10.5px] tracking-wider uppercase py-2 px-4 sm:px-8 border-b border-gray-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">

      <div class="flex items-center space-x-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span class="font-medium text-gray-300">TITAN OPTICAL LAB</span>
        <span class="text-gray-600">|</span>
        <span>CERTIFIED • TOLERANCE ±0.01MM</span>
        <span class="text-gray-600">|</span>
        <span>COMPLIMENTARY 1.60 HIGH-INDEX LENSES</span>
      </div>

      <div class="flex items-center space-x-2 text-gray-400">
        <span>FREE SHIPPING US & INDIA</span>
        <span>•</span>
        <span>ISO 13485 ACCREDITED</span>
      </div>

    </div>
  </aside>

  <!-- Main Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between gap-6">

      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#0d1624] text-white flex items-center justify-center font-serif font-bold text-lg tracking-tighter shadow-sm">
          TF
        </div>

        <div>
          <span class="font-bold tracking-tight text-xl text-gray-950 font-serif leading-none block">MyFrames</span>
          <span class="text-[9px] uppercase tracking-widest text-gray-500 font-semibold block">PRECISION OPTICS</span>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-6 text-xs font-semibold tracking-wider text-gray-800 uppercase">
        <a href="/" class="hover:text-[#bd5319] transition-colors">EYEGLASSES</a>
      </nav>

      <!-- Search -->
      <div class="flex-1 max-w-xl mx-2 md:mx-6">
        <div class="relative">
          <input
            class="w-full bg-[#f4f6f8] text-xs text-gray-800 placeholder-gray-400 pl-4 pr-4 py-2.5 rounded-full border border-gray-200 focus:outline-none focus:border-gray-400 focus:bg-white transition-all shadow-inner"
            placeholder="Search Titan, Hexagonal, Round, Panto..."
            type="search">
        </div>
      </div>

      <!-- Right Actions -->
      <div class="flex items-center space-x-5 text-gray-700 shrink-0">

        <a href="#" class="flex flex-col items-center group" title="Wishlist">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
          </svg>
          <span class="text-[9px] uppercase tracking-wider font-semibold mt-1 text-gray-500">Wishlist</span>
        </a>

        <a href="#" class="flex flex-col items-center group" title="Cart">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
          </svg>
          <span class="text-[9px] uppercase tracking-wider font-semibold mt-1 text-gray-500">Cart</span>
        </a>

        <a href="/profile" class="flex flex-col items-center group" title="Profile">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
          </svg>
          <span class="text-[9px] uppercase tracking-wider font-semibold mt-1 text-gray-500">Profile</span>
        </a>

      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow py-10 px-4 sm:px-6 lg:px-8">

    <div class="max-w-4xl mx-auto space-y-6">

      <!-- Breadcrumb -->
      <nav>
        <a href="/profile" class="inline-flex items-center text-xs font-bold text-gray-900 hover:text-amber-800 transition-colors tracking-wide">
          <span class="mr-1 text-sm font-normal">←</span>
          BACK TO ACCOUNT
        </a>
      </nav>

      <!-- Page Heading -->
      <header class="pt-2 flex flex-col md:flex-row md:items-end justify-between gap-4 pb-2">

        <div class="space-y-1">
          <span class="text-[11px] font-bold uppercase tracking-widest text-[#ba581f] block">
            ATELIER MEMBER PROFILE
          </span>

          <h1 class="text-3xl sm:text-4xl font-serif-title font-medium text-gray-900 tracking-tight">
            Personal Information
          </h1>

          <p class="text-xs text-gray-500 font-normal max-w-xl">
            <strong>Manage your personal details, contact information, and account verification for your Titan optical orders.</strong>
          </p>
        </div>

        <!-- Account Status -->
        <div class="shrink-0 mb-1">
          <% if (user.isBlocked) { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold tracking-wider uppercase bg-rose-50 text-rose-700 border border-rose-200">
              ACCOUNT BLOCKED
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold tracking-wider uppercase bg-[#e8f6ed] text-[#1b7a43] border border-[#c4ebd1]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              ACCOUNT ACTIVE
            </span>
          <% } %>
        </div>

      </header>

      <!-- Profile Information Card -->
      <section class="bg-white rounded-xl shadow-sm border border-gray-200/90 overflow-hidden divide-y divide-gray-100">

        <!-- Avatar Section -->
        <div class="p-6 sm:p-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 bg-white">

          <div class="relative shrink-0">

            <div class="w-24 h-24 rounded-full p-1 border-2 border-emerald-100 bg-[#e7eff4] flex items-center justify-center overflow-hidden">

              <% if (user.profilePhoto) { %>

                <img
                  src="<%= user.profilePhoto %>"
                  alt="Profile Photo"
                  class="w-full h-full rounded-full object-cover">

              <% } else { %>

                <svg class="w-10 h-10 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>

              <% } %>

            </div>

            <% if (user.isEmailVerified) { %>
              <div class="absolute bottom-0.5 right-0.5 bg-[#ba581f] text-white p-1 rounded-full border-2 border-white shadow-sm flex items-center justify-center" title="Verified Member">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            <% } %>

          </div>

          <!-- User Details -->
          <div class="flex-1 text-center sm:text-left space-y-3">

            <div>
              <h2 class="text-xl font-bold font-serif-title text-gray-900 leading-tight">
                <%= user.name %>
              </h2>

              <p class="text-[11px] font-medium text-gray-400 tracking-wider uppercase mt-1">
                MYFRAMES MEMBER
              </p>
            </div>

            <p class="text-[11px] text-gray-500">
              Your registered profile information.
            </p>

            <p class="text-[10px] text-gray-400">
              Profile picture can be updated from the Edit Profile page.
            </p>

          </div>
        </div>

        <!-- Member Credentials -->
        <div class="p-6 sm:p-8 space-y-6 bg-white">

          <!-- Section Heading -->
          <div class="flex items-center justify-between pb-1 border-b border-gray-100">

            <div class="flex items-center space-x-2">
              <span class="text-amber-700 text-lg">🪪</span>
              <h3 class="text-base sm:text-lg font-serif-title font-semibold text-gray-900 tracking-tight">
                Member Credentials
              </h3>
            </div>

            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold tracking-wider uppercase bg-gray-100 text-gray-600 border border-gray-200">
              <span class="mr-1">●</span> VIEW MODE
            </span>

          </div>

          <!-- Form Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">

            <!-- Full Name -->
            <div class="space-y-1.5">

              <div class="flex justify-between items-center text-[10.5px] font-bold uppercase tracking-wider text-gray-600">
                <label>FULL LEGAL NAME</label>
              </div>

              <input
                class="w-full text-xs font-medium text-gray-800 bg-[#f1f3f5] border border-gray-200 rounded-md px-3.5 py-2.5 cursor-not-allowed shadow-inner"
                type="text"
                value="<%= user.name || 'Not provided' %>"
                disabled>

              <p class="text-[10px] text-gray-400">
                Your registered full name.
              </p>

            </div>

            <!-- Email Address -->
            <div class="space-y-1.5">

              <div class="flex justify-between items-center text-[10.5px] font-bold uppercase tracking-wider text-gray-600">
                <label>EMAIL ADDRESS</label>

                <% if (user.isEmailVerified) { %>
                  <span class="inline-flex items-center text-[10px] font-bold text-emerald-700 tracking-wider uppercase">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    VERIFIED
                  </span>
                <% } else { %>
                  <span class="text-[10px] font-bold text-amber-700 uppercase">NOT VERIFIED</span>
                <% } %>

              </div>

              <input
                class="w-full text-xs font-medium text-gray-800 bg-[#f1f3f5] border border-gray-200 rounded-md px-3.5 py-2.5 shadow-inner"
                type="email"
                value="<%= user.email || 'Not provided' %>"
                disabled>

              <p class="text-[10px] text-gray-400">
                Your registered email address.
              </p>

            </div>

            <!-- Phone Number -->
            <div class="space-y-1.5">

              <div class="flex justify-between items-center text-[10.5px] font-bold uppercase tracking-wider text-gray-600">
                <label>PHONE NUMBER</label>
              </div>

              <input
                class="w-full text-xs font-medium text-gray-800 bg-[#f1f3f5] border border-gray-200 rounded-md px-3.5 py-2.5 shadow-inner"
                type="text"
                value="<%= user.phone || 'Not provided' %>"
                disabled>

              <p class="text-[10px] text-gray-400">
                Your registered phone number.
              </p>

            </div>

            <!-- Date of Birth -->
            <div class="space-y-1.5">

              <div class="flex justify-between items-center text-[10.5px] font-bold uppercase tracking-wider text-gray-600">
                <label>DATE OF BIRTH</label>
                <span class="text-gray-400 text-[10px] lowercase font-normal">(optional)</span>
              </div>

              <input
                class="w-full text-xs font-medium text-gray-800 bg-[#f1f3f5] border border-gray-200 rounded-md px-3.5 py-2.5 shadow-inner"
                type="text"
                value="<%= user.dateOfBirth ? new Date(user.dateOfBirth).toLocaleDateString('en-IN') : 'Not provided' %>"
                disabled>

              <p class="text-[10px] text-gray-400">
                Your date of birth.
              </p>

            </div>

            <!-- Gender -->
            <div class="md:col-span-2 space-y-1.5">

              <div class="flex justify-between items-center text-[10.5px] font-bold uppercase tracking-wider text-gray-600">
                <label>GENDER IDENTITY</label>
                <span class="text-gray-400 text-[10px] lowercase font-normal">(optional)</span>
              </div>

              <input
                class="w-full text-xs font-medium text-gray-800 bg-[#f1f3f5] border border-gray-200 rounded-md px-3.5 py-2.5 shadow-inner"
                type="text"
                value="<%= user.gender || 'Not provided' %>"
                disabled>

              <p class="text-[10px] text-gray-400">
                Your selected gender.
              </p>

            </div>

          </div>

          <!-- Bottom Action Bar -->
          <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">

            <div class="flex items-center text-gray-500 text-[11px]">
              <svg class="w-4 h-4 text-gray-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
              </svg>

              <span>
                <strong>Your personal information is protected.</strong>
              </span>
            </div>

            <!-- Edit Profile Button -->
            <a
              href="/edit-profile"
              class="inline-flex items-center px-6 py-2.5 rounded-full bg-[#18202d] text-white text-xs font-semibold tracking-wider hover:bg-black transition-all shadow hover:shadow-md">

              <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
              </svg>

              EDIT PROFILE
            </a>

          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-[#0b101c] text-gray-300 pt-16 pb-10 border-t border-gray-900 mt-16 text-xs">

    <div class="max-w-7xl mx-auto px-4 sm:px-8">

      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-gray-800">

        <!-- Brand -->
        <div class="space-y-4 md:pr-4">

          <div class="flex items-center space-x-2.5">
            <div class="w-8 h-8 rounded-full bg-[#c85a17] text-white flex items-center justify-center font-serif font-bold text-sm">
              TF
            </div>

            <div>
              <span class="font-serif font-bold text-lg text-white tracking-tight leading-none block">MyFrames Precision</span>
              <span class="text-[8px] uppercase tracking-widest text-gray-400 font-semibold block">CERTIFIED OPHTHALMIC LABORATORY</span>
            </div>
          </div>

          <p class="text-[11px] text-gray-400 leading-relaxed font-light">
            Medical-grade beta titanium and hand-carved cellulose acetate frames. Engineered with sub-millimeter precision.
          </p>

        </div>

        <!-- Lab Engineering -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white">LAB ENGINEERING</h4>

          <ul class="space-y-2 text-[11px] text-gray-400">
            <li><a href="#" class="hover:text-gray-100">Ti-811 Beta Titanium</a></li>
            <li><a href="#" class="hover:text-gray-100">Refractive Index Profiling</a></li>
            <li><a href="#" class="hover:text-gray-100">Laser Axis Calibration</a></li>
            <li><a href="#" class="hover:text-gray-100">Digital Free-Form Surfacing</a></li>
          </ul>
        </div>

        <!-- Customer Support -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white">CUSTOMER SUPPORT</h4>

          <ul class="space-y-2 text-[11px] text-gray-400">
            <li><a href="#" class="hover:text-gray-100">Optometrist Video Consultation</a></li>
            <li><a href="#" class="hover:text-gray-100">Pupillary Distance Tool</a></li>
            <li><a href="#" class="hover:text-gray-100">International Freight & Duties</a></li>
            <li><a href="#" class="hover:text-gray-100">Atelier Warranty & Tune-ups</a></li>
          </ul>
        </div>

        <!-- Optical Journal -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white">OPTICAL JOURNAL</h4>

          <p class="text-[11px] text-gray-400 leading-relaxed font-light">
            Receive monograph updates on ophthalmic engineering and bespoke frame silhouettes.
          </p>

          <form class="relative flex items-center pt-1" onsubmit="event.preventDefault();">
            <input
              class="w-full bg-[#161e2e] text-gray-200 text-xs rounded-full pl-4 pr-11 py-2.5 border border-gray-700 focus:outline-none focus:border-amber-600 shadow-inner"
              placeholder="optics@atelier.com"
              type="email">

            <button
              class="absolute right-1 w-8 h-8 rounded-full bg-[#c85a17] text-white flex items-center justify-center hover:bg-[#bd5319]"
              title="Subscribe"
              type="submit">
              →
            </button>
          </form>
        </div>

      </div>

      <!-- Copyright -->
      <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-[10px] text-gray-500 gap-4">

        <div>
          © 2025 MyFrames Precision Optics & Titan Eyeplus. All rights reserved.
        </div>

        <div class="flex items-center space-x-6 uppercase tracking-wider font-medium">
          <a href="#" class="hover:text-gray-300">PRIVACY POLICY</a>
          <a href="#" class="hover:text-gray-300">TERMS OF SERVICE</a>
          <a href="#" class="hover:text-gray-300">ISO CERTIFICATION</a>
        </div>

      </div>

    </div>
  </footer>

</body>
</html>
