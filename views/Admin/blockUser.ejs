<%
  const isBlocked = Boolean(user && user.isBlocked);
  const userName = user && user.name ? user.name : "Unknown User";
  const userEmail = user && user.email ? user.email : "No email available";
  const userId = user && user._id ? String(user._id) : "";
  const userPhone = user && user.phone ? user.phone : "Not provided";

  const createdDate = user && user.createdAt
    ? new Date(user.createdAt).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric"
      })
    : "Not available";
%>

