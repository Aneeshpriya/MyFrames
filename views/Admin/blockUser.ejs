    <!-- ========================================================= -->
    <!-- PAGE CONTENT -->
    <!-- ========================================================= -->

    <main class="flex-1 overflow-y-auto px-6 sm:px-8 lg:px-10 py-7">

      <div class="max-w-5xl mx-auto space-y-6">


        <!-- PAGE HEADER -->
        <div class="space-y-2">

          <div class="flex items-center space-x-1.5 text-rose-500 font-semibold text-[10px] uppercase tracking-wider">

            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" x2="19.07" y1="4.93" y2="19.07"></line>
            </svg>

            <span>Security &amp; Moderation</span>

          </div>


          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

            <div>
              <h1 class="text-2xl font-bold text-white tracking-tight">
                Block User Account
              </h1>

              <p class="text-xs text-slate-400 mt-1">
                Restrict platform access and suspend account privileges for this customer.
              </p>
            </div>


            <div class="flex items-center gap-2.5 flex-shrink-0">

              <% if (isBlocked) { %>

                <button
                  type="button"
                  onclick="unblockUser()"
                  class="inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium text-teal-300 bg-teal-500/10 border border-teal-500/30 hover:bg-teal-500/20 rounded-lg transition-colors"
                >

                  <svg
                    class="w-3.5 h-3.5 text-teal-400"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
                    <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                  </svg>

                  <span>Unblock User</span>

                </button>

              <% } %>


              <a
                class="inline-flex items-center space-x-2 px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-900/80 border border-slate-700/80 hover:bg-slate-800 rounded-lg transition-colors"
                href="/admin/users"
              >

                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <line x1="19" x2="5" y1="12" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>

                <span>Back to Users</span>

              </a>

            </div>

          </div>

        </div>


        <!-- ===================================================== -->
        <!-- MAIN CARD -->
        <!-- ===================================================== -->

        <section
          class="bg-[#0f1626]/90 border border-slate-800/80 rounded-2xl p-5 sm:p-7 shadow-2xl relative"
        >

          <form
            id="block-user-form"
            class="space-y-6"
            onsubmit="event.preventDefault(); openConfirmationModal();"
          >


            <!-- ROW 1 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- USER ID -->
              <div class="space-y-2">

                <label
                  class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase"
                >
                  1. User ID
                </label>

                <div class="relative rounded-lg bg-[#0a0f1d] border border-slate-800/90">

                  <input
                    class="w-full pl-3.5 pr-10 py-2.5 bg-transparent border-0 font-mono text-teal-400 text-xs tracking-wide focus:ring-0 cursor-default"
                    readonly
                    type="text"
                    value="<%= userId %>"
                  >

                  <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">

                    <svg
                      class="w-4 h-4 text-slate-500"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>

                  </div>

                </div>

              </div>


              <!-- FULL NAME -->
              <div class="space-y-2">

                <label
                  class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase"
                >
                  2. Full Name
                </label>

                <div class="relative rounded-lg bg-[#0a0f1d] border border-slate-800/90">

                  <input
                    class="w-full pl-3.5 pr-10 py-2.5 bg-transparent border-0 text-slate-200 text-xs font-medium focus:ring-0 cursor-default"
                    readonly
                    type="text"
                    value="<%= userName %>"
                  >

                  <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-teal-400">

                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>

                  </div>

                </div>

              </div>

            </div>


            <!-- ROW 2 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- EMAIL -->
              <div class="space-y-2">

                <label
                  class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase"
                >
                  3. Email Address
                </label>

                <div class="rounded-lg bg-[#0a0f1d] border border-slate-800/90">

                  <input
                    class="w-full px-3.5 py-2.5 bg-transparent border-0 text-slate-300 text-xs focus:ring-0 cursor-default"
                    readonly
                    type="email"
                    value="<%= userEmail %>"
                  >

                </div>

              </div>


              <!-- STATUS -->
              <div class="space-y-2">

                <label class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase">
                  4. Account Status
                </label>

                <div class="min-h-[42px] px-3.5 py-2 rounded-lg bg-[#0a0f1d] border border-slate-800/90 flex flex-wrap items-center gap-2">

                  <span class="text-[11px] text-slate-400 font-medium">
                    Current:
                  </span>

                  <% if (isBlocked) { %>

                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                      Blocked
                    </span>

                  <% } else { %>

                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-teal-400 shadow-[0_0_6px_#2dd4bf]"></span>
                      Active
                    </span>

                    <svg
                      class="w-4 h-4 text-slate-500"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <line x1="5" x2="19" y1="12" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>

                    <span class="text-[11px] text-slate-400 font-medium">
                      New:
                    </span>

                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                      Blocked
                    </span>

                  <% } %>

                </div>

              </div>

            </div>


            <!-- ROW 3 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- REASON -->
              <div class="space-y-2">

                <label
                  class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase"
                  for="blocking-reason"
                >
                  5. Reason for Blocking
                </label>

                <div class="relative rounded-lg bg-[#0a0f1d] border border-slate-800/90">

                  <select
                    class="w-full pl-3.5 pr-10 py-2.5 bg-transparent border-0 text-slate-200 text-xs font-medium focus:ring-0 appearance-none cursor-pointer"
                    id="blocking-reason"
                  >
                    <option>Fraudulent Transactions &amp; Payment Abuse</option>
                    <option>Repeated Policy Violations &amp; Return Abuse</option>
                    <option>Suspicious Account Activity / Compromised</option>
                    <option>Chargeback / Payment Dispute Fraud</option>
                    <option>Abusive Behavior Toward Support Staff</option>
                    <option>Other (Specify in notes below)</option>
                  </select>

                  <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">

                    <svg
                      class="w-4 h-4 text-slate-500"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        clip-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        fill-rule="evenodd"
                      ></path>
                    </svg>

                  </div>

                </div>

              </div>


              <!-- DURATION -->
              <div class="space-y-2">

                <div class="flex items-center justify-between">

                  <label
                    class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase"
                    for="block-duration"
                  >
                    6. Block Duration
                  </label>

                  <span class="text-[11px] text-teal-400/80 font-medium">
                    Optional
                  </span>

                </div>

                <div class="relative rounded-lg bg-[#0a0f1d] border border-slate-800/90">

                  <select
                    class="w-full pl-3.5 pr-10 py-2.5 bg-transparent border-0 text-slate-200 text-xs font-medium focus:ring-0 appearance-none cursor-pointer"
                    id="block-duration"
                  >
                    <option>Permanent (Indefinite)</option>
                    <option>24 Hours</option>
                    <option>7 Days</option>
                    <option>30 Days</option>
                  </select>

                  <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">

                    <svg
                      class="w-4 h-4 text-slate-500"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        clip-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25 4.5a.75.75 0 01.02-1.06z"
                        fill-rule="evenodd"
                      ></path>
                    </svg>

                  </div>

                </div>

                <p class="text-[10px] text-slate-500">
                  Optional: Leave as Permanent for indefinite restriction or select a temporary suspension window.
                </p>

              </div>

            </div>


            <!-- NOTES -->
            <div class="space-y-2">

              <div class="flex items-center justify-between">

                <label
                  class="block text-[11px] font-semibold text-slate-400 tracking-wider uppercase"
                  for="additional-notes"
                >
                  7. Additional Notes
                </label>

                <span class="text-[11px] text-slate-500">
                  Optional details
                </span>

              </div>

              <div class="rounded-lg bg-[#0a0f1d] border border-slate-800/90">

                <textarea
                  class="w-full p-3.5 bg-transparent border-0 text-slate-300 text-xs placeholder-slate-600 focus:ring-0 resize-none font-normal leading-relaxed"
                  id="additional-notes"
                  placeholder="Provide specific incident context, compliance ticket numbers, or evidence summary..."
                  rows="3"
                ></textarea>

              </div>

            </div>


            <!-- AUDIT LOG -->
            <div class="rounded-xl bg-[#0a0f1d]/70 border border-slate-800/90 p-4 space-y-3">

              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-800/60 pb-2.5">

                <div class="flex items-center space-x-2 text-slate-300 font-medium text-xs">

                  <svg
                    class="w-4 h-4 text-teal-400"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>

                  <span class="font-semibold text-slate-200 tracking-wide uppercase text-[11px]">
                    Audit &amp; Compliance Logging
                  </span>

                </div>

                <span class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded-full bg-slate-900 border border-slate-700/80 text-[10px] font-mono text-teal-400">

                  <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>

                  <span>Admin Audit Log</span>

                </span>

              </div>


              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

                <div class="flex items-center justify-between gap-4 p-2 rounded bg-slate-900/40 border border-slate-800/50">

                  <span class="text-slate-500 text-[11px]">
                    Admin Identity
                  </span>

                  <span class="font-medium text-slate-200 text-[11px] text-right">
                    Priya (Master Admin)
                  </span>

                </div>


                <div class="flex items-center justify-between gap-4 p-2 rounded bg-slate-900/40 border border-slate-800/50">

                  <span class="text-slate-500 text-[11px]">
                    Action Recorded
                  </span>

                  <span class="font-mono text-rose-400 font-medium text-[11px] text-right">
                    USER_ACCOUNT_BLOCKED
                  </span>

                </div>


                <div class="flex items-center justify-between gap-4 p-2 rounded bg-slate-900/40 border border-slate-800/50">

                  <span class="text-slate-500 text-[11px]">
                    Customer
                  </span>

                  <span class="text-slate-300 text-[11px] text-right truncate max-w-[220px]">
                    <%= userName %>
                  </span>

                </div>


                <div class="flex items-center justify-between gap-4 p-2 rounded bg-slate-900/40 border border-slate-800/50">

                  <span class="text-slate-500 text-[11px]">
                    Registered
                  </span>

                  <span class="font-mono text-slate-300 text-[11px] text-right">
                    <%= createdDate %>
                  </span>

                </div>

              </div>


              <p class="text-[10px] text-slate-500 flex items-center space-x-1.5 pt-1">

                <svg
                  class="w-3.5 h-3.5 text-teal-400 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>

                <span>
                  This action will be recorded in the admin audit log.
                </span>

              </p>

            </div>


            <!-- ACTION BUTTONS -->
            <div class="pt-2 flex items-center justify-end gap-3">

              <a
                href="/admin/users/<%= userId %>"
                class="px-5 py-2 text-xs font-medium text-slate-300 bg-slate-800/50 hover:bg-slate-800 border border-slate-700/80 rounded-lg transition-colors"
              >
                Cancel
              </a>


              <% if (!isBlocked) { %>

                <button
                  class="inline-flex items-center space-x-2 px-5 py-2 text-xs font-semibold text-white bg-[#e11d48] hover:bg-[#f43f5e] rounded-lg shadow-lg glow-red transition-all focus:outline-none"
                  type="submit"
                >

                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    viewBox="0 0 24 24"
                  >
                    <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>

                  <span>
                    Confirm Block
                  </span>

                </button>

              <% } %>

            </div>

          </form>

        </section>

      </div>

    </main>

  </div>


  <!-- ========================================================= -->
  <!-- CONFIRMATION MODAL -->
  <!-- ========================================================= -->

  <div
    aria-modal="true"
    class="hidden fixed inset-0 z-50 bg-[#080c14]/80 backdrop-blur-sm items-center justify-center p-4"
    id="confirmation-modal"
    role="dialog"
  >

    <!-- IMPORTANT:
         The modal width is controlled here.
         The warning text is no longer inside the icon container.
    -->

    <div
      class="bg-[#0c121e] border border-slate-700/80 rounded-2xl shadow-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto"
    >

      <div class="p-6 sm:p-7 space-y-5">


        <!-- MODAL HEADER -->
        <div class="flex items-start justify-between gap-4">

          <div class="flex items-start gap-3 min-w-0">

            <!-- ICON ONLY -->
            <div
              class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-500 flex-shrink-0"
            >

              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
                <path d="M10.3 3.7 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"></path>
              </svg>

            </div>


            <!-- TITLE -->
            <div class="min-w-0">

              <h2 class="text-base font-bold text-white tracking-tight">
                Confirm Account Block
              </h2>

              <p class="text-xs text-slate-400 mt-0.5">
                High-privilege security action
              </p>

            </div>

          </div>


          <!-- CLOSE -->
          <button
            aria-label="Close modal"
            class="text-slate-500 hover:text-slate-300 p-1 rounded-lg transition-colors flex-shrink-0"
            onclick="closeConfirmationModal()"
            type="button"
          >

            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <line x1="18" x2="6" y1="6" y2="18"></line>
              <line x1="6" x2="18" y1="6" y2="18"></line>
            </svg>

          </button>

        </div>


        <!-- WARNING -->
        <div
          class="p-4 rounded-lg bg-rose-500/10 border border-rose-500/20 text-xs text-rose-300/90 leading-relaxed"
        >

          <p>
            Are you sure you want to block the account for
            <strong class="text-white font-semibold">
              <%= userName %>
            </strong>?
          </p>

          <p class="mt-1.5">
            This will immediately prevent the user from accessing their account.
          </p>

        </div>


        <!-- SUMMARY -->
        <div
          class="rounded-lg bg-[#080c14] border border-slate-800 p-4 space-y-0"
        >

          <!-- CUSTOMER NAME -->
          <div
            class="flex items-start justify-between gap-6 py-3 border-b border-slate-800/60"
          >

            <span class="text-slate-500 text-xs flex-shrink-0">
              Customer Name
            </span>

            <span class="font-medium text-slate-200 text-xs text-right break-words">
              <%= userName %>
            </span>

          </div>


          <!-- USER ID -->
          <div
            class="flex items-start justify-between gap-6 py-3 border-b border-slate-800/60"
          >

            <span class="text-slate-500 text-xs flex-shrink-0">
              User ID
            </span>

            <span
              class="font-mono text-teal-400 text-[11px] text-right break-all max-w-[65%]"
            >
              <%= userId %>
            </span>

          </div>


          <!-- TARGET STATUS -->
          <div
            class="flex items-center justify-between gap-6 py-3 border-b border-slate-800/60"
          >

            <span class="text-slate-500 text-xs">
              Target Status
            </span>

            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 font-semibold text-[10px] flex-shrink-0"
            >

              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>

              Blocked

            </span>

          </div>


          <!-- REASON -->
          <div
            class="flex items-start justify-between gap-6 py-3 border-b border-slate-800/60"
          >

            <span class="text-slate-500 text-xs flex-shrink-0">
              Reason
            </span>

            <span
              id="modal-reason"
              class="font-medium text-slate-200 text-xs text-right break-words max-w-[65%]"
            >
              Fraudulent Transactions &amp; Payment Abuse
            </span>

          </div>


          <!-- DURATION -->
          <div
            class="flex items-start justify-between gap-6 py-3"
          >

            <span class="text-slate-500 text-xs flex-shrink-0">
              Block Duration
            </span>

            <span
              id="modal-duration"
              class="font-medium text-teal-300 font-mono text-[11px] text-right"
            >
              Permanent (Indefinite)
            </span>

          </div>

        </div>


        <!-- MODAL ACTIONS -->
        <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-3 pt-2">

          <button
            class="px-5 py-2.5 text-xs font-medium text-slate-300 bg-slate-800/60 hover:bg-slate-800 border border-slate-700/80 rounded-lg transition-colors focus:outline-none"
            onclick="closeConfirmationModal()"
            type="button"
          >
            Cancel
          </button>


          <button
            id="confirm-block-button"
            class="inline-flex items-center justify-center space-x-2 px-5 py-2.5 text-xs font-semibold text-white bg-[#e11d48] hover:bg-[#f43f5e] rounded-lg shadow-lg glow-red transition-all focus:outline-none"
            onclick="confirmBlockUser()"
            type="button"
          >

            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              viewBox="0 0 24 24"
            >
              <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>

            <span>
              Yes, Confirm Block
            </span>

          </button>

        </div>

      </div>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- JAVASCRIPT -->
  <!-- ========================================================= -->

  <script>

    const USER_ID = "<%= userId %>";

    function openConfirmationModal() {

      const modal = document.getElementById("confirmation-modal");

      const reason = document.getElementById("blocking-reason").value;
      const duration = document.getElementById("block-duration").value;

      document.getElementById("modal-reason").textContent = reason;
      document.getElementById("modal-duration").textContent = duration;

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      document.body.classList.add("overflow-hidden");
    }


    function closeConfirmationModal() {

      const modal = document.getElementById("confirmation-modal");

      modal.classList.add("hidden");
      modal.classList.remove("flex");

      document.body.classList.remove("overflow-hidden");
    }


    async function confirmBlockUser() {

      const confirmButton = document.getElementById("confirm-block-button");

      confirmButton.disabled = true;

      confirmButton.innerHTML = `
        <svg
          class="w-3.5 h-3.5 animate-spin"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="3"
            opacity="0.25"
          ></circle>

          <path
            d="M4 12a8 8 0 018-8"
            stroke="currentColor"
            stroke-width="3"
          ></path>
        </svg>

        <span>Blocking...</span>
      `;


      try {

        const response = await fetch(
          `/api/admin/users/${encodeURIComponent(USER_ID)}/block`,
          {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json"
            }
          }
        );


        const data = await response.json();


        if (!response.ok) {

          throw new Error(
            data.message || "Failed to block user"
          );

        }


        closeConfirmationModal();

        alert(
          "User account has been blocked successfully."
        );

        window.location.href =
          `/admin/users/${encodeURIComponent(USER_ID)}`;

      } catch (error) {

        console.error("Block user error:", error);

        alert(
          error.message || "Failed to block user account."
        );

        confirmButton.disabled = false;

        confirmButton.innerHTML = `
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            viewBox="0 0 24 24"
          >
            <rect
              height="11"
              rx="2"
              ry="2"
              width="18"
              x="3"
              y="11"
            ></rect>

            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>

          <span>Yes, Confirm Block</span>
        `;

      }

    }


    async function unblockUser() {

      if (!confirm("Are you sure you want to unblock this user?")) {
        return;
      }


      try {

        const response = await fetch(
          `/api/admin/users/${encodeURIComponent(USER_ID)}/unblock`,
          {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json"
            }
          }
        );


        const data = await response.json();


        if (!response.ok) {

          throw new Error(
            data.message || "Failed to unblock user"
          );

        }


        alert(
          "User account has been unblocked successfully."
        );

        window.location.reload();

      } catch (error) {

        console.error("Unblock user error:", error);

        alert(
          error.message || "Failed to unblock user account."
        );

      }

    }


    async function logoutAdmin() {

      try {

        await fetch("/api/admin/logout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          }
        });

      } catch (error) {

        console.error("Logout error:", error);

      } finally {

        window.location.href = "/admin/login";

      }

    }


    // Close modal when clicking outside it
    document
      .getElementById("confirmation-modal")
      .addEventListener("click", function (event) {

        if (event.target === this) {
          closeConfirmationModal();
        }

      });


    // Close modal with Escape key
    document.addEventListener("keydown", function (event) {

      if (event.key === "Escape") {
        closeConfirmationModal();
      }

    });

  </script>

</body>

</html>