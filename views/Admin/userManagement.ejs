    document.getElementById("totalUsers");

  const activeUsers =
    document.getElementById("activeUsers");

  const blockedUsers =
    document.getElementById("blockedUsers");

  const recordsCounter =
    document.getElementById("recordsCounter");

  const userSearch =
    document.getElementById("userSearch");

  const logoutButton =
    document.getElementById("logoutButton");


  // =========================================================
  // State
  // =========================================================

  let allUsers = [];


  // =========================================================
  // Load Users
  // =========================================================

  async function loadUsers() {

    try {

      const response = await fetch(
        "/api/admin/users",
        {
          method: "GET",

          credentials: "same-origin",

          headers: {
            "Accept": "application/json"
          }
        }
      );


      const data = await response.json();


      // Session expired / unauthorized

      if (response.status === 401) {

        window.location.href = "/admin/login";

        return;

      }


      if (!response.ok) {

        throw new Error(
          data.message || "Failed to fetch users"
        );

      }


      if (
        !data.success ||
        !Array.isArray(data.users)
      ) {

        throw new Error(
          "Invalid users response"
        );

      }


      allUsers = data.users;


      updateStatistics();

      renderUsers(allUsers);

    }

    catch (error) {

      console.error(
        "Load users error:",
        error
      );


      usersTableBody.innerHTML = `
        <tr>

          <td
            colspan="6"
            class="py-10 text-center text-rose-400"
          >
            Failed to load users.
          </td>

        </tr>
      `;


      recordsCounter.innerHTML = `
        Showing
        <span class="text-white font-semibold">
          0
        </span>
        users
      `;

    }

  }


  // =========================================================
  // Update Statistics
  // =========================================================

  function updateStatistics() {

    const total =
      allUsers.length;


    const blocked =
      allUsers.filter(
        user => user.isBlocked === true
      ).length;


    const active =
      total - blocked;


    totalUsers.textContent =
      total.toLocaleString();


    activeUsers.textContent =
      active.toLocaleString();


    blockedUsers.textContent =
      blocked.toLocaleString();

  }


  // =========================================================
  // Render Users
  // =========================================================

  function renderUsers(users) {

    usersTableBody.innerHTML = "";


    if (!Array.isArray(users) || users.length === 0) {

      usersTableBody.innerHTML = `
        <tr>

          <td
            colspan="6"
            class="py-10 text-center text-slate-500"
          >
            No users found.
          </td>

        </tr>
      `;


      updateRecordsCounter(0);

      return;

    }


    users.forEach((user, index) => {

      const userId =
        user._id
          ? String(user._id)
          : "";


      const name =
        user.name
          ? String(user.name)
          : "Unknown User";


      const email =
        user.email
          ? String(user.email)
          : "No email";


      const isBlocked =
        user.isBlocked === true;


      const initials =
        getInitials(name);


      // =====================================================
      // Status
      // =====================================================

      const statusHtml = isBlocked

        ? `
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-300"
          >

            <span
              class="w-1.5 h-1.5 rounded-full bg-rose-400"
            ></span>

            Blocked

          </span>
        `

        : `
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300"
          >

            <span
              class="w-1.5 h-1.5 rounded-full bg-emerald-400"
            ></span>

            Active

          </span>
        `;


      // =====================================================
      // Create Row
      // =====================================================

      const row =
        document.createElement("tr");


      row.className =
        "hover:bg-slate-900/30 transition-colors group";


      row.innerHTML = `

        <!-- Number -->

        <td class="py-4 px-4 text-slate-400 font-mono">

          ${index + 1}

        </td>


        <!-- User ID -->

        <td class="py-4 px-6">

          <div
            class="inline-flex items-center px-3 py-2 rounded-xl bg-[#090f19] border border-[#162740] font-mono text-[11px] font-semibold text-slate-200"
          >

            ${escapeHtml(userId)}

          </div>

        </td>


        <!-- User Name -->

        <td class="py-4 px-6">

          <div class="flex items-center gap-3">

            <div
              class="w-8 h-8 rounded-full bg-slate-800/80 border border-slate-700 flex items-center justify-center font-bold text-slate-300 text-xs"
            >

              ${escapeHtml(initials)}

            </div>

            <span
              class="text-white font-semibold text-sm"
            >

              ${escapeHtml(name)}

            </span>

          </div>

        </td>


        <!-- Email -->

        <td class="py-4 px-6 text-slate-400">

          ${escapeHtml(email)}

        </td>


        <!-- Status -->

        <td class="py-4 px-6">

          ${statusHtml}

        </td>


        <!-- Action -->

        <td class="py-4 px-4 text-right">

          <a
            href="/admin/users/${encodeURIComponent(userId)}"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-teal-500/40 bg-teal-950/20 hover:bg-teal-900/40 text-teal-300 text-xs font-medium transition"
          >

            <svg
              class="w-3.5 h-3.5 text-teal-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >

              <path
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>

              <path
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>

            </svg>

            <span>
              View Details
            </span>

          </a>

        </td>

      `;


      usersTableBody.appendChild(row);

    });


    updateRecordsCounter(users.length);

  }


  // =========================================================
  // Records Counter
  // =========================================================

  function updateRecordsCounter(count) {

    recordsCounter.innerHTML = `
      Showing

      <span class="text-white font-semibold">
        ${count.toLocaleString()}
      </span>

      users
    `;

  }


  // =========================================================
  // Search Users
  // =========================================================

  userSearch.addEventListener(
    "input",
    function () {

      const searchTerm =
        this.value
          .trim()
          .toLowerCase();


      // Show all users

      if (!searchTerm) {

        renderUsers(allUsers);

        return;

      }


      // Filter users

      const filteredUsers =
        allUsers.filter(user => {

          const name =
            String(user.name || "")
              .toLowerCase();


          const email =
            String(user.email || "")
              .toLowerCase();


          const id =
            String(user._id || "")
              .toLowerCase();


          return (
            name.includes(searchTerm) ||
            email.includes(searchTerm) ||
            id.includes(searchTerm)
          );

        });


      renderUsers(filteredUsers);

    }
  );


  // =========================================================
  // Generate Initials
  // =========================================================

  function getInitials(name) {

    const cleanName =
      String(name || "").trim();


    if (!cleanName) {
      return "U";
    }


    return cleanName
      .split(/\s+/)
      .slice(0, 2)
      .map(
        word => word.charAt(0)
      )
      .join("")
      .toUpperCase();

  }


  // =========================================================
  // Escape HTML
  // =========================================================

  function escapeHtml(value) {

    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  }


  // =========================================================
  // Logout
  // =========================================================

  logoutButton.addEventListener(
    "click",
    async function () {

      try {

        const response =
          await fetch(
            "/api/admin/logout",
            {
              method: "POST",
              credentials: "same-origin",

              headers: {
                "Accept": "application/json"
              }
            }
          );


        if (response.ok) {

          window.location.href =
            "/admin/login";

          return;

        }


        if (response.status === 401) {

          window.location.href =
            "/admin/login";

          return;

        }


        const data =
          await response.json()
            .catch(() => null);


        console.error(
          "Logout failed:",
          data?.message || "Unknown error"
        );

      }

      catch (error) {

        console.error(
          "Logout error:",
          error
        );

      }

    }
  );


  // =========================================================
  // Load Page
  // =========================================================

  loadUsers();

</script>

</body>
</html>