<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sign in to MyFrames Admin</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: "#111111",
            cream: "#F8F6F1",
            gold: "#B08D57"
          },
          fontFamily: {
            serif: ["EB Garamond", "serif"],
            sans: ["Inter", "sans-serif"]
          }
        }
      }
    };
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  >
</head>

<body class="min-h-screen bg-cream text-ink">

  <main class="min-h-screen flex items-center justify-center px-6 py-12">

    <div class="w-full max-w-md">

      <!-- Brand -->
      <div class="text-center mb-10">

        <h1 class="font-serif text-4xl font-semibold tracking-wide">
          MyFrames
        </h1>

        <p class="mt-2 text-xs tracking-[0.25em] uppercase text-gray-500">
          Admin Portal
        </p>

      </div>


      <!-- Login Card -->
      <div class="bg-white border border-gray-200 shadow-sm px-8 py-10">

        <div class="mb-8">

          <h2 class="font-serif text-3xl font-semibold">
            Welcome back
          </h2>

          <p class="mt-2 text-sm text-gray-500">
            Sign in to manage your MyFrames store.
          </p>

        </div>


        <!-- Login Form -->
        <form id="admin-login-form" novalidate>

          <!-- Email -->
          <div class="mb-5">

            <label
              for="work-email"
              class="block text-sm font-medium mb-2"
            >
              Work email
            </label>

            <input
              id="work-email"
              name="email"
              type="email"
              autocomplete="username"
              placeholder="admin@myframe.com"
              class="w-full rounded-none border-gray-300 px-4 py-3 text-sm focus:border-black focus:ring-black"
              required
            >

          </div>


          <!-- Password -->
          <div class="mb-5">

            <label
              for="admin-password"
              class="block text-sm font-medium mb-2"
            >
              Password
            </label>

            <div class="relative">

              <input
                id="admin-password"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="Enter your password"
                class="w-full rounded-none border-gray-300 px-4 py-3 pr-12 text-sm focus:border-black focus:ring-black"
                required
              >

              <!-- Password Toggle -->
              <button
                type="button"
                id="toggle-password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-black"
                aria-label="Show password"
              >

                <svg
                  id="eye-open"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 12s3.75-6 9.75-6 9.75 6 9.75 6-3.75 6-9.75 6-9.75-6-9.75-6Z"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="2.5"
                  />
                </svg>

                <svg
                  id="eye-closed"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 hidden"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 3l18 18"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10.58 10.58a2 2 0 0 0 2.83 2.83"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9.88 5.09A10.58 10.58 0 0 1 12 4.88c6 0 9.75 7.12 9.75 7.12a18.7 18.7 0 0 1-3.14 3.94"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6.61 6.61A18.8 18.8 0 0 0 2.25 12s3.75 7.12 9.75 7.12a10.8 10.8 0 0 0 3.88-.74"
                  />
                </svg>

              </button>

            </div>

          </div>


          <!-- Remember Me / Forgot Password -->
          <div class="flex items-center justify-between mb-6">

            <label class="flex items-center gap-2 text-sm text-gray-600">

              <input
                id="remember-me"
                name="rememberMe"
                type="checkbox"
                class="rounded border-gray-300 text-black focus:ring-black"
              >

              <span>Remember me</span>

            </label>

            <a
              href="/forgot-password"
              class="text-sm text-gray-600 hover:text-black underline underline-offset-4"
            >
              Forgot password?
            </a>

          </div>


          <!-- Feedback -->
          <div
            id="signin-feedback"
            class="hidden mb-5 rounded border px-4 py-3 text-sm"
            role="alert"
          ></div>


          <!-- Sign In Button -->
          <button
            id="login-button"
            type="submit"
            class="w-full bg-black text-white py-3.5 text-sm font-medium tracking-wide hover:bg-gray-800 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Sign in
          </button>

        </form>


        <!-- Divider -->
        <div class="flex items-center gap-4 my-8">

          <div class="h-px flex-1 bg-gray-200"></div>

          <span class="text-xs uppercase tracking-widest text-gray-400">
            or
          </span>

          <div class="h-px flex-1 bg-gray-200"></div>

        </div>


        <!-- Google Workspace -->
        <button
          id="google-login-button"
          type="button"
          class="w-full border border-gray-300 py-3.5 text-sm font-medium hover:bg-gray-50 transition"
        >
          Continue with Google Workspace
        </button>


        <!-- Footer -->
        <p class="text-center text-xs text-gray-400 mt-8">
          Authorized MyFrames administrators only.
        </p>

      </div>

    </div>

  </main>


  <script>

    // ==========================================
    // Elements
    // ==========================================

    const loginForm =
      document.getElementById("admin-login-form");

    const emailInput =
      document.getElementById("work-email");

    const passwordInput =
      document.getElementById("admin-password");

    const togglePassword =
      document.getElementById("toggle-password");

    const eyeOpen =
      document.getElementById("eye-open");

    const eyeClosed =
      document.getElementById("eye-closed");

    const feedback =
      document.getElementById("signin-feedback");

    const loginButton =
      document.getElementById("login-button");

    const googleLoginButton =
      document.getElementById("google-login-button");

    const rememberMe =
      document.getElementById("remember-me");


    // ==========================================
    // Password Show / Hide
    // ==========================================

    togglePassword.addEventListener("click", () => {

      const isPassword =
        passwordInput.type === "password";

      passwordInput.type =
        isPassword ? "text" : "password";

      eyeOpen.classList.toggle(
        "hidden",
        isPassword
      );

      eyeClosed.classList.toggle(
        "hidden",
        !isPassword
      );

      togglePassword.setAttribute(
        "aria-label",
        isPassword
          ? "Hide password"
          : "Show password"
      );

    });


    // ==========================================
    // Feedback
    // ==========================================

    function showFeedback(message, type = "error") {

      feedback.textContent = message;

      feedback.classList.remove(
        "hidden",
        "border-red-200",
        "bg-red-50",
        "text-red-700",
        "border-green-200",
        "bg-green-50",
        "text-green-700"
      );

      if (type === "success") {

        feedback.classList.add(
          "border-green-200",
          "bg-green-50",
          "text-green-700"
        );

      } else {

        feedback.classList.add(
          "border-red-200",
          "bg-red-50",
          "text-red-700"
        );

      }

    }


    // ==========================================
    // Admin Login
    // ==========================================

    loginForm.addEventListener("submit", async (event) => {

      event.preventDefault();

      const email =
        emailInput.value.trim();

      const password =
        passwordInput.value;


      // Validate email
      if (!email) {

        showFeedback(
          "Please enter your work email."
        );

        emailInput.focus();

        return;
      }


      // Validate password
      if (!password) {

        showFeedback(
          "Please enter your password."
        );

        passwordInput.focus();

        return;
      }


      // Disable button
      loginButton.disabled = true;
      loginButton.textContent = "Signing in...";

      feedback.classList.add("hidden");


      try {

        const response = await fetch(
          "/api/admin/login",
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json"
            },

            credentials: "same-origin",

            body: JSON.stringify({
              email,
              password,
              rememberMe: rememberMe.checked
            })
          }
        );


        const data =
          await response.json();


        // Login failed
        if (!response.ok) {

          showFeedback(
            data.message ||
            "Invalid email or password."
          );

          return;
        }


        // Login successful
        showFeedback(
          data.message ||
          "Admin login successful.",
          "success"
        );


        // Session cookie is created by the server.
        // No JWT/localStorage is needed.


        // Redirect to dashboard
        setTimeout(() => {

          window.location.href =
            "/admin/dashboard";

        }, 500);


      } catch (error) {

        console.error(
          "Admin login error:",
          error
        );

        showFeedback(
          "Unable to connect to the server. Please try again."
        );

      } finally {

        loginButton.disabled = false;
        loginButton.textContent = "Sign in";

      }

    });


    // ==========================================
    // Google Workspace
    // ==========================================

    googleLoginButton.addEventListener(
      "click",
      () => {

        showFeedback(
          "Google Workspace login will be connected in Day 3."
        );

      }
    );

  </script>

</body>
</html>