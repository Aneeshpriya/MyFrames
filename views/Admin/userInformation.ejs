<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    MyFrames Admin - User Information <%= user.name %>
  </title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <!-- Tailwind Configuration -->
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            background: "#070b14",
            surface: "#0c1322",
            panel: "#101827",
            border: "#1e2a42",
            accent: "#14b8a6"
          }
        }
      }
    };
  </script>
</head>

<body class="bg-[#070b14] text-slate-200 min-h-screen">

  <!-- ==========================================
       PAGE WRAPPER
  =========================================== -->

  <div class="min-h-screen flex flex-col">

    <!-- ==========================================
         HEADER
    =========================================== -->

    <header
      class="h-16 border-b border-[#1e2a42] bg-[#0a101c] flex items-center justify-between px-6 sticky top-0 z-30"
    >

      <!-- Logo -->
      <div class="flex items-center space-x-3">

        <div
          class="w-9 h-9 rounded-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center"
        >
          <svg
            class="w-5 h-5 text-teal-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M8 9.5l4 2.25 4-2.25M12 12v4.5"
            />
          </svg>
        </div>

        <div>
          <h1 class="text-sm font-semibold text-white tracking-wide">
            MyFrames
          </h1>

          <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500">
            Admin Panel
          </p>
        </div>

      </div>

      <!-- Header Right -->
      <div class="flex items-center space-x-4">

        <div class="hidden sm:block text-right">
          <p class="text-xs font-semibold text-slate-200">
            Administrator
          </p>

          <p class="text-[10px] text-slate-500">
            MyFrames Management
          </p>
        </div>

        <div
          class="w-9 h-9 rounded-full bg-teal-500/10 border border-teal-500/30 flex items-center justify-center"
        >
          <span class="text-xs font-bold text-teal-400">
            A
          </span>
        </div>

      </div>

    </header>


    <!-- ==========================================
         MAIN LAYOUT
    =========================================== -->

    <div class="flex flex-1 min-w-0">

      <!-- ==========================================
           SIDEBAR
      =========================================== -->

      <aside
        class="hidden lg:flex w-64 shrink-0 border-r border-[#1e2a42] bg-[#090f1a] flex-col"
      >

        <!-- Navigation -->
        <nav class="p-4 space-y-1">

          <!-- Dashboard -->
          <a
            href="/admin/dashboard"
            class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#111a2b] transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M3 12l9-9 9 9M5 10v10h14V10"
              />
            </svg>

            <span class="text-sm font-medium">
              Dashboard
            </span>
          </a>


          <!-- User Management -->
          <a
            href="/admin/users"
            class="flex items-center space-x-3 px-3 py-2.5 rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/10 transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"
              />

              <circle
                cx="9"
                cy="7"
                r="4"
                stroke-width="1.8"
              />

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
              />
            </svg>

            <span class="text-sm font-medium">
              User Management
            </span>
          </a>


          <!-- Orders -->
          <a
            href="#"
            class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-500 hover:text-slate-300 hover:bg-[#111a2b] transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M6 2l1.5 4h9L18 2M4 6h16l-1.5 14h-13L4 6z"
              />
            </svg>

            <span class="text-sm font-medium">
              Orders
            </span>
          </a>


          <!-- Products -->
          <a
            href="#"
            class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-500 hover:text-slate-300 hover:bg-[#111a2b] transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"
              />
            </svg>

            <span class="text-sm font-medium">
              Products
            </span>
          </a>


          <!-- Settings -->
          <a
            href="#"
            class="flex items-center space-x-3 px-3 py-2.5 rounded-lg text-slate-500 hover:text-slate-300 hover:bg-[#111a2b] transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M12 15.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7z"
              />

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M19.4 15a1.7 1.7 0 00.34 1.88l.06.06-1.8 1.8-.06-.06a1.7 1.7 0 00-1.88-.34 1.7 1.7 0 00-1.03 1.56V20h-2.55v-.1a1.7 1.7 0 00-1.03-1.56 1.7 1.7 0 00-1.88.34l-.06.06-1.8-1.8.06-.06A1.7 1.7 0 008.1 15a1.7 1.7 0 00-1.56-1.03h-.1v-2.55h.1A1.7 1.7 0 008.1 10.4a1.7 1.7 0 00-.34-1.88L7.7 8.46l1.8-1.8.06.06a1.7 1.7 0 001.88.34 1.7 1.7 0 001.03-1.56V5h2.55v.1a1.7 1.7 0 001.03 1.56 1.7 1.7 0 001.88-.34l.06-.06 1.8 1.8-.06.06a1.7 1.7 0 00-.34 1.88 1.7 1.7 0 001.56 1.03h.1v2.55h-.1A1.7 1.7 0 0019.4 15z"
              />
            </svg>

            <span class="text-sm font-medium">
              Settings
            </span>
          </a>

        </nav>


        <!-- Sidebar Bottom -->
        <div class="mt-auto p-4 border-t border-[#1e2a42]">

          <form action="/api/admin/logout" method="POST">

            <button
              type="submit"
              class="w-full flex items-center justify-center space-x-2 px-3 py-2.5 rounded-lg border border-[#1e2a42] bg-[#0c1322] hover:bg-[#131d33] text-slate-300 hover:text-white text-xs font-medium transition"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M10 17l5-5-5-5M15 12H3m12-7h4a2 2 0 012 2v10a2 2 0 01-2 2h-4"
                />
              </svg>

              <span>
                Logout
              </span>
            </button>

          </form>

        </div>

      </aside>


      <!-- ==========================================
           PAGE CONTENT
      =========================================== -->

      <main class="flex-1 min-w-0 overflow-y-auto">

        <div class="w-full max-w-none px-4 sm:px-6 lg:px-8 py-6 space-y-6">


          <!-- ==========================================
               BREADCRUMB
          =========================================== -->

          <div
            class="flex items-center flex-wrap gap-2 text-xs font-semibold tracking-wider text-slate-400 uppercase"
          >

            <a
              href="/admin/dashboard"
              class="hover:text-teal-400 transition"
            >
              Dashboard
            </a>

            <span class="text-slate-600">
              /
            </span>

            <a
              href="/admin/users"
              class="hover:text-teal-400 transition"
            >
              Users
            </a>

            <span class="text-slate-600">
              /
            </span>

            <span class="text-slate-500">
              User Information
            </span>

          </div>


          <!-- ==========================================
               PAGE HEADING + ACTIONS
          =========================================== -->

          <div
            class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-5"
          >

            <div class="min-w-0">

              <h1
                class="text-2xl font-bold text-white tracking-tight break-words"
              >
                User Information: <%= user.name %>
              </h1>

              <p class="text-sm text-slate-400 mt-1">
                View customer profile information and account status.
              </p>

            </div>


            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-2 shrink-0">

              <!-- Back -->
              <a
                href="/admin/users"
                class="px-3.5 py-2 rounded-lg border border-[#1e2a42] bg-[#0c1322] hover:bg-[#131d33] text-slate-300 text-xs font-medium transition flex items-center gap-1.5"
              >
                <span>←</span>
                <span>Back to Users</span>
              </a>


              <!-- Edit -->
              <a
                href="/admin/users/<%= user._id %>/edit"
                class="inline-block"
              >
                <button
                  type="button"
                  class="px-3.5 py-2 rounded-lg bg-teal-500 hover:bg-teal-400 text-slate-950 text-xs font-semibold transition flex items-center gap-1.5 shadow-[0_0_12px_rgba(20,184,166,0.18)]"
                >
                  <span>✎</span>
                  <span>Edit User</span>
                </button>
              </a>


              <!-- Block -->
              <% if (user.isBlocked) { %>

                <span
                  class="px-3.5 py-2 rounded-lg border border-red-500/20 bg-red-500/10 text-red-400 text-xs font-semibold flex items-center gap-1.5"
                >
                  <span>🚫</span>
                  <span>Blocked</span>
                </span>

              <% } else { %>

                <a
                  href="/admin/users/<%= user._id %>/block"
                  class="inline-block"
                >
                  <button
                    type="button"
                    class="px-3.5 py-2 rounded-lg border border-red-500/20 bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-semibold transition flex items-center gap-1.5"
                  >
                    <span>🚫</span>
                    <span>Block User</span>
                  </button>
                </a>

              <% } %>


              <!-- Delete -->
              <button
                type="button"
                onclick="deleteUser('<%= user._id %>')"
                class="px-3.5 py-2 rounded-lg border border-red-500/20 bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-semibold transition flex items-center gap-1.5"
              >
                <span>🗑️</span>
                <span>Delete User</span>
              </button>

            </div>

          </div>


          <!-- ==========================================
               USER PROFILE
          =========================================== -->

          <section
            class="w-full bg-[#0c1322] border border-[#1e2a42] rounded-xl overflow-hidden"
          >

            <!-- Card Header -->
            <div class="px-5 sm:px-6 py-5 border-b border-[#1e2a42]">

              <div class="flex flex-col sm:flex-row sm:items-center gap-4">

                <!-- Avatar -->
                <div
                  class="w-16 h-16 rounded-full bg-teal-500/10 border border-teal-500/30 flex items-center justify-center shrink-0"
                >
                  <span class="text-2xl font-bold text-teal-400">
                    <%= user.name
                      ? user.name.charAt(0).toUpperCase()
                      : "U"
                    %>
                  </span>
                </div>


                <!-- Name -->
                <div class="min-w-0 flex-1">

                  <div class="flex flex-wrap items-center gap-2">

                    <h2 class="text-xl font-bold text-white break-words">
                      <%= user.name %>
                    </h2>

                    <% if (user.isBlocked) { %>

                      <span
                        class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-red-500/10 text-red-400 border border-red-500/20"
                      >
                        BLOCKED
                      </span>

                    <% } else { %>

                      <span
                        class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                      >
                        ACTIVE
                      </span>

                    <% } %>

                  </div>

                  <p class="text-xs text-slate-400 mt-1">
                    Customer account
                  </p>

                </div>

              </div>

            </div>


            <!-- Profile Details -->
            <div class="p-5 sm:p-6">

              <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
              >

                <!-- Full Name -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Full Name
                  </p>

                  <p class="text-sm font-medium text-slate-200 mt-1 break-words">
                    <%= user.name || "Not provided" %>
                  </p>

                </div>


                <!-- Email -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Email Address
                  </p>

                  <span
                    class="text-sm font-medium text-slate-200 mt-1 block break-all"
                    title="<%= user.email || '' %>"
                  >
                    <%= user.email || "Not provided" %>
                  </span>

                </div>


                <!-- Phone -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Phone Number
                  </p>

                  <span
                    class="text-sm font-medium text-slate-200 mt-1 block break-words font-mono"
                  >
                    <%= user.phone || "Not provided" %>
                  </span>

                </div>


                <!-- Date of Birth -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Date of Birth
                  </p>

                  <p class="text-sm font-medium text-slate-200 mt-1">

                    <% if (user.dateOfBirth) { %>

                      <%= new Date(user.dateOfBirth).toLocaleDateString(
                        "en-IN",
                        {
                          day: "2-digit",
                          month: "short",
                          year: "numeric"
                        }
                      ) %>

                    <% } else { %>

                      Not provided

                    <% } %>

                  </p>

                </div>


                <!-- Gender -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Gender
                  </p>

                  <p class="text-sm font-medium text-slate-200 mt-1 break-words">
                    <%= user.gender || "Not provided" %>
                  </p>

                </div>


                <!-- Email Verification -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Email Verification
                  </p>

                  <% if (user.isEmailVerified) { %>

                    <span
                      class="inline-flex items-center mt-1 px-2 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                    >
                      ✓ Verified
                    </span>

                  <% } else { %>

                    <span
                      class="inline-flex items-center mt-1 px-2 py-1 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20"
                    >
                      Not verified
                    </span>

                  <% } %>

                </div>


                <!-- Account Status -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Account Status
                  </p>

                  <% if (user.isBlocked) { %>

                    <span
                      class="inline-flex items-center mt-1 px-2 py-1 rounded-full text-[10px] font-semibold bg-red-500/10 text-red-400 border border-red-500/20"
                    >
                      Blocked
                    </span>

                  <% } else { %>

                    <span
                      class="inline-flex items-center mt-1 px-2 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                    >
                      Active
                    </span>

                  <% } %>

                </div>


                <!-- User ID -->
                <div class="min-w-0 sm:col-span-2">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    User ID
                  </p>

                  <p class="text-xs font-mono text-slate-300 mt-1 break-all">
                    <%= user._id %>
                  </p>

                </div>


                <!-- Registration Date -->
                <div class="min-w-0">

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Registered On
                  </p>

                  <p class="text-sm font-medium text-slate-200 mt-1">

                    <% if (user.createdAt) { %>

                      <%= new Date(user.createdAt).toLocaleString(
                        "en-IN",
                        {
                          day: "2-digit",
                          month: "short",
                          year: "numeric",
                          hour: "2-digit",
                          minute: "2-digit",
                          hour12: true
                        }
                      ) %>

                    <% } else { %>

                      Not available

                    <% } %>

                  </p>

                </div>

              </div>

            </div>

          </section>


          <!-- ==========================================
               ACCOUNT OVERVIEW
          =========================================== -->

          <section
            class="w-full bg-[#0c1322] border border-[#1e2a42] rounded-xl overflow-hidden"
          >

            <div class="px-5 sm:px-6 py-5 border-b border-[#1e2a42]">

              <h2 class="text-base font-bold text-white">
                Account Overview
              </h2>

              <p class="text-xs text-slate-400 mt-1">
                Current account information and management status.
              </p>

            </div>


            <div class="p-5 sm:p-6">

              <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"
              >

                <!-- Orders -->
                <div
                  class="p-4 rounded-lg border border-[#1e2a42] bg-[#0a101c] min-w-0"
                >

                  <div class="flex items-center justify-between gap-3">

                    <span class="text-xs text-slate-400">
                      Orders
                    </span>

                    <span class="text-lg">
                      🛍️
                    </span>

                  </div>

                  <p class="text-xl font-bold text-white mt-3">
                    —
                  </p>

                  <p class="text-[10px] text-slate-500 mt-1">
                    Order data not connected yet
                  </p>

                </div>


                <!-- Cart -->
                <div
                  class="p-4 rounded-lg border border-[#1e2a42] bg-[#0a101c] min-w-0"
                >

                  <div class="flex items-center justify-between gap-3">

                    <span class="text-xs text-slate-400">
                      Cart Items
                    </span>

                    <span class="text-lg">
                      🛒
                    </span>

                  </div>

                  <p class="text-xl font-bold text-white mt-3">
                    —
                  </p>

                  <p class="text-[10px] text-slate-500 mt-1">
                    Cart data not connected yet
                  </p>

                </div>


                <!-- Wishlist -->
                <div
                  class="p-4 rounded-lg border border-[#1e2a42] bg-[#0a101c] min-w-0"
                >

                  <div class="flex items-center justify-between gap-3">

                    <span class="text-xs text-slate-400">
                      Wishlist
                    </span>

                    <span class="text-lg">
                      ♡
                    </span>

                  </div>

                  <p class="text-xl font-bold text-white mt-3">
                    —
                  </p>

                  <p class="text-[10px] text-slate-500 mt-1">
                    Wishlist data not connected yet
                  </p>

                </div>


                <!-- Reviews -->
                <div
                  class="p-4 rounded-lg border border-[#1e2a42] bg-[#0a101c] min-w-0"
                >

                  <div class="flex items-center justify-between gap-3">

                    <span class="text-xs text-slate-400">
                      Reviews
                    </span>

                    <span class="text-lg">
                      ★
                    </span>

                  </div>

                  <p class="text-xl font-bold text-white mt-3">
                    —
                  </p>

                  <p class="text-[10px] text-slate-500 mt-1">
                    Review data not connected yet
                  </p>

                </div>

              </div>

            </div>

          </section>


          <!-- ==========================================
               MANAGEMENT INFORMATION
          =========================================== -->

          <section
            class="w-full bg-[#0c1322] border border-[#1e2a42] rounded-xl overflow-hidden"
          >

            <div class="px-5 sm:px-6 py-5 border-b border-[#1e2a42]">

              <h2 class="text-base font-bold text-white">
                Management Information
              </h2>

              <p class="text-xs text-slate-400 mt-1">
                Administrative controls and account management.
              </p>

            </div>


            <div class="p-5 sm:p-6">

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <!-- Account Status -->
                <div
                  class="p-4 rounded-lg border border-[#1e2a42] bg-[#0a101c]"
                >

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Account Status
                  </p>

                  <div class="mt-3 flex items-center gap-2">

                    <% if (user.isBlocked) { %>

                      <span
                        class="w-2 h-2 rounded-full bg-red-400 shrink-0"
                      ></span>

                      <span class="text-sm font-semibold text-red-400">
                        Account is blocked
                      </span>

                    <% } else { %>

                      <span
                        class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"
                      ></span>

                      <span class="text-sm font-semibold text-emerald-400">
                        Account is active
                      </span>

                    <% } %>

                  </div>

                </div>


                <!-- Email Status -->
                <div
                  class="p-4 rounded-lg border border-[#1e2a42] bg-[#0a101c]"
                >

                  <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">
                    Email Status
                  </p>

                  <div class="mt-3 flex items-center gap-2">

                    <% if (user.isEmailVerified) { %>

                      <span
                        class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"
                      ></span>

                      <span class="text-sm font-semibold text-emerald-400">
                        Email verified
                      </span>

                    <% } else { %>

                      <span
                        class="w-2 h-2 rounded-full bg-amber-400 shrink-0"
                      ></span>

                      <span class="text-sm font-semibold text-amber-400">
                        Email not verified
                      </span>

                    <% } %>

                  </div>

                </div>

              </div>

            </div>

          </section>


          <!-- ==========================================
               FOOTER NOTE
          =========================================== -->

          <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pt-2 pb-6"
          >

            <p class="text-[10px] text-slate-500">
              MyFrames Admin Panel
            </p>

            <p class="text-[10px] text-slate-600">
              User information
            </p>

          </div>

        </div>

      </main>

    </div>

  </div>


  <!-- ==========================================
       DELETE USER SCRIPT
  =========================================== -->

  <script>
    async function deleteUser(userId) {

      const confirmed = confirm(
        "Are you sure you want to delete this user? This action cannot be undone."
      );

      if (!confirmed) {
        return;
      }

      try {

        const response = await fetch(
          `/api/admin/users/${userId}`,
          {
            method: "DELETE",
            credentials: "include"
          }
        );

        const data = await response.json();

        if (!response.ok) {

          alert(
            data.message ||
            "Failed to delete user."
          );

          return;
        }

        alert("User deleted successfully.");

        window.location.href = "/admin/users";

      } catch (error) {

        console.error(
          "Delete user error:",
          error
        );

        alert(
          "Something went wrong while deleting the user."
        );
      }
    }
  </script>

</body>

