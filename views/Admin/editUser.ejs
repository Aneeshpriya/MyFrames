<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta
    content="width=device-width, initial-scale=1.0"
    name="viewport"
  >

  <title>
    MyFrames Admin - Edit User (<%= user.name %>)
  </title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <!-- Tailwind Config -->
  <script>

    tailwind.config = {
      darkMode: "class",

      theme: {

        extend: {

          colors: {
            deepNavy: "#070b12",
            surfaceDark: "#0e1626",
            cardBg: "#111b2d",
            innerCard: "#090f1a",
            borderSubtle: "#1d2c44",
            brandTeal: "#00d2aa",
            brandTealHover: "#00b894",
            brandTealDark: "#0a3536",
            accentCyan: "#06b6d4",
            accentGold: "#d97706",
            accentPurple: "#8b5cf6",
            accentRose: "#f43f5e"
          },

          fontFamily: {

            sans: [
              "Inter",
              "system-ui",
              "-apple-system",
              "BlinkMacSystemFont",
              "Segoe UI",
              "Roboto",
              "sans-serif"
            ],

            mono: [
              "JetBrains Mono",
              "ui-monospace",
              "SFMono-Regular",
              "Menlo",
              "monospace"
            ]

          }

        }

      }

    };

  </script>


  <!-- Google Fonts -->

  <link
    href="https://fonts.googleapis.com"
    rel="preconnect"
  >

  <link
    crossorigin=""
    href="https://fonts.gstatic.com"
    rel="preconnect"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  >


  <style>

    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }

    ::-webkit-scrollbar-track {
      background: #080c14;
    }

    ::-webkit-scrollbar-thumb {
      background: #1c2738;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #2a3a52;
    }

    .glow-teal-sm {
      box-shadow: 0 0 14px -2px rgba(0, 210, 170, 0.28);
    }

    .glow-teal-btn {
      box-shadow: 0 4px 18px 0 rgba(0, 210, 170, 0.35);
    }

  </style>

</head>


<body
  class="bg-deepNavy text-slate-300 font-sans antialiased min-h-screen flex flex-col selection:bg-brandTeal selection:text-black"
>


<!-- =========================================================
     APP SHELL
========================================================= -->

<div
  class="flex flex-1 min-h-screen overflow-x-hidden"
  data-purpose="app-shell"
>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
  class="w-64 flex-shrink-0 bg-surfaceDark border-r border-borderSubtle flex flex-col justify-between z-20"
  data-purpose="navigation-sidebar"
>

  <div>

    <!-- Brand Header -->

    <div
      class="px-5 py-5 border-b border-borderSubtle/60 flex items-center justify-between"
    >

      <div class="flex items-center space-x-3">

        <div
          class="w-9 h-9 rounded-lg bg-emerald-950/80 border border-brandTeal/40 flex items-center justify-center text-brandTeal shadow-[0_0_12px_rgba(0,210,170,0.2)]"
        >

          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            viewBox="0 0 24 24"
          >

            <path
              d="M3 10a4 4 0 018 0v1H3v-1zm10 0a4 4 0 018 0v1h-8v-1zM11 11h2M3 10l2-4m16 4l-2-4"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

        </div>


        <div>

          <h1
            class="text-sm font-bold tracking-tight text-white flex items-center gap-1.5 leading-none"
          >
            MyFrames
          </h1>

          <span
            class="text-[9px] tracking-wider text-slate-400 font-medium uppercase mt-0.5 block"
          >
            Studio Admin Luxe
          </span>

        </div>

      </div>


      <span
        class="text-[10px] font-mono tracking-widest px-1.5 py-0.5 rounded border border-cyan-800/80 bg-cyan-950/40 text-cyan-300"
      >
        CONSOLE
      </span>

    </div>


    <!-- Section Label -->

    <div
      class="px-5 pt-5 pb-2 text-[10px] font-bold tracking-wider text-slate-500 uppercase"
    >
      Architecture &amp; Operations
    </div>


    <!-- Navigation -->

    <nav
      class="px-3 space-y-1 text-xs font-medium"
    >


      <!-- Dashboard -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="/admin/dashboard"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <rect
              height="7"
              rx="1.5"
              width="7"
              x="3"
              y="3"
            ></rect>

            <rect
              height="7"
              rx="1.5"
              width="7"
              x="14"
              y="3"
            ></rect>

            <rect
              height="7"
              rx="1.5"
              width="7"
              x="14"
              y="14"
            ></rect>

            <rect
              height="7"
              rx="1.5"
              width="7"
              x="3"
              y="14"
            ></rect>

          </svg>

          <span>
            Dashboard
          </span>

        </div>

      </a>


      <!-- Products -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="#"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

            <path
              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span>
            Products
          </span>

        </div>

        <div class="flex items-center space-x-1">

          <span class="text-[11px] text-slate-400">
            148
          </span>

          <svg
            class="w-3.5 h-3.5 text-slate-500"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M19 9l-7 7-7-7"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

        </div>

      </a>


      <!-- Category -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="#"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M4 6h16M4 12h16M4 18h7"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span>
            Category Management
          </span>

        </div>

      </a>


      <!-- Orders -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="#"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span>
            Order Management
          </span>

        </div>

        <span
          class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-950/70 border border-amber-600/50 text-amber-300"
        >
          12 Pending
        </span>

      </a>


      <!-- Sales -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="#"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span>
            Sales Reports &amp; Revenue
          </span>

        </div>

      </a>


      <!-- User Management -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg bg-brandTealDark/50 border border-brandTeal/50 text-brandTeal font-medium glow-teal-sm"
        href="/admin/users"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-brandTeal"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span class="text-white">
            User Management
          </span>

        </div>

        <span
          class="w-1.5 h-1.5 rounded-full bg-brandTeal shadow-[0_0_8px_#00d2aa]"
        ></span>

      </a>


      <!-- Coupons -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="#"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span>
            Coupons &amp; Offers
          </span>

        </div>

        <span
          class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-purple-950/70 border border-purple-600/50 text-purple-300"
        >
          3 Active
        </span>

      </a>


      <!-- Inventory -->

      <a
        class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/40 transition"
        href="#"
      >

        <div class="flex items-center space-x-2.5">

          <svg
            class="w-4 h-4 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>

          </svg>

          <span>
            Inventory
          </span>

        </div>

        <span
          class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-rose-950/70 border border-rose-600/50 text-rose-300"
        >
          4 Low
        </span>

      </a>

    </nav>

  </div>


  <!-- Sidebar Footer -->

  <div
    class="p-3 border-t border-borderSubtle/60 space-y-2.5"
  >

    <div
      class="flex items-center justify-between px-3 py-2 bg-innerCard/90 border border-borderSubtle rounded-lg text-xs"
    >

      <div class="flex items-center space-x-2">

        <span class="relative flex h-2 w-2">

          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
          ></span>

          <span
            class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
          ></span>

        </span>

        <span class="text-[11px] text-slate-300 font-medium">
          Live Operational
        </span>

      </div>

      <span
        class="text-[11px] font-mono text-emerald-400 font-semibold"
      >
        99.98%
      </span>

    </div>


    <div
      class="flex items-center justify-between p-2 rounded-lg bg-innerCard/90 border border-borderSubtle"
    >

      <div class="flex items-center space-x-2.5">

        <div
          class="w-8 h-8 rounded-lg bg-brandTeal text-slate-950 flex items-center justify-center font-bold text-sm"
        >
          A
        </div>

        <div>

          <p class="text-xs font-semibold text-white leading-tight">
            Administrator
          </p>

          <p class="text-[10px] text-slate-400 leading-tight">
            Master Admin
          </p>

        </div>

      </div>


      <button
        id="logoutBtn"
        aria-label="Logout"
        class="text-slate-400 hover:text-white p-1 rounded transition"
        type="button"
      >

        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >

          <path
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>

        </svg>

      </button>

    </div>

  </div>

</aside>


<!-- =========================================================
     MAIN CONTENT
========================================================= -->

<div class="flex-1 flex flex-col min-w-0">


<!-- =========================================================
     TOP HEADER
========================================================= -->

<header
  class="h-16 bg-surfaceDark/80 backdrop-blur border-b border-borderSubtle px-6 flex items-center justify-between gap-4 sticky top-0 z-10"
>

  <div class="relative flex-1 max-w-xl">

    <div
      class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500"
    >

      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >

        <path
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

      </svg>

    </div>

    <input
      class="w-full bg-innerCard/90 border border-borderSubtle rounded-lg pl-10 pr-4 py-1.5 text-xs text-slate-400 cursor-pointer placeholder-slate-500 focus:outline-none focus:border-brandTeal/50"
      readonly
      type="text"
      value="Search orders, products, customers, SKUs... (⌘K)"
    >

  </div>


  <div class="flex items-center space-x-3">

    <button
      aria-label="Notifications"
      class="relative p-2 rounded-lg text-slate-400 hover:text-white hover:bg-innerCard transition"
      type="button"
    >

      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >

        <path
          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

      </svg>

      <span
        class="absolute top-1.5 right-1.5 w-1.5 h-1.5 bg-brandTeal rounded-full"
      ></span>

    </button>


    <button
      aria-label="Help"
      class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-innerCard transition"
      type="button"
    >

      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >

        <path
          d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

      </svg>

    </button>


    <div class="flex items-center space-x-1 pl-1 cursor-pointer">

      <div
        class="w-7 h-7 rounded-full bg-purple-600/90 text-white flex items-center justify-center text-xs font-semibold"
      >

        <svg
          class="w-4 h-4"
          fill="currentColor"
          viewBox="0 0 24 24"
        >

          <path
            d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
          ></path>

        </svg>

      </div>

      <svg
        class="w-3.5 h-3.5 text-slate-500"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >

        <path
          d="M19 9l-7 7-7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

      </svg>

    </div>

  </div>

</header>


<!-- =========================================================
     PAGE CONTENT
========================================================= -->

<main
  class="flex-1 p-6 space-y-6 overflow-y-auto"
>


  <!-- Breadcrumb -->

  <div class="space-y-4">

    <div
      class="flex items-center space-x-2 text-xs font-semibold tracking-wider text-slate-400 uppercase"
    >

      <a
        href="/admin/dashboard"
        class="hover:text-white transition"
      >
        Dashboard
      </a>

      <span class="text-slate-600">
        /
      </span>

      <a
        href="/admin/users"
        class="hover:text-white transition"
      >
        User Management
      </a>

      <span class="text-slate-600">
        /
      </span>

      <span class="text-slate-200">
        Edit User
      </span>

    </div>


    <div
      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
    >

      <div>

        <h2
          class="text-2xl font-bold text-white tracking-tight"
        >
          Edit User
        </h2>

        <p class="text-xs text-slate-400 mt-1">
          Manage customer information and account settings.
        </p>

      </div>


      <!-- Customer ID -->

      <div
        class="flex items-center space-x-2 text-xs text-slate-400 bg-innerCard border border-borderSubtle px-3 py-1.5 rounded-lg"
      >

        <span
          class="w-2 h-2 rounded-full bg-brandTeal"
        ></span>

        <span>

          Customer ID:

          <span
            class="font-mono text-slate-200 font-semibold break-all"
          >
            <%= user._id %>
          </span>

        </span>

      </div>

    </div>

  </div>


  <!-- =======================================================
       USER CONTENT
  ======================================================== -->

  <div class="space-y-6">


    <!-- =====================================================
         PROFILE SUMMARY
    ====================================================== -->

    <div
      class="bg-cardBg border border-borderSubtle rounded-2xl p-6"
    >

      <div
        class="flex flex-col lg:flex-row lg:items-center justify-between gap-6"
      >


        <!-- Profile -->

        <div class="flex items-center space-x-4">

          <div class="relative flex-shrink-0">

            <div
              class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brandTeal to-emerald-500 text-slate-950 flex items-center justify-center text-2xl font-bold"
            >
              <%= user.name
                ? user.name.charAt(0).toUpperCase()
                : "U"
              %>
            </div>


            <span
              class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full <%= user.isBlocked ? 'bg-red-500' : 'bg-emerald-500' %> border-2 border-cardBg"
            ></span>

          </div>


          <div>

            <div
              class="flex flex-wrap items-center gap-2.5"
            >

              <h3
                class="text-xl font-bold text-white tracking-tight"
              >
                <%= user.name || "Unnamed User" %>
              </h3>


              <% if (user.isBlocked) { %>

                <span
                  class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-950/60 border border-red-500/30 text-red-300"
                >

                  <span
                    class="w-1.5 h-1.5 rounded-full bg-red-400"
                  ></span>

                  <span>
                    Blocked
                  </span>

                </span>

              <% } else { %>

                <span
                  class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-950/60 border border-emerald-500/30 text-emerald-300"
                >

                  <span
                    class="w-1.5 h-1.5 rounded-full bg-emerald-400"
                  ></span>

                  <span>
                    Active
                  </span>

                </span>

              <% } %>

            </div>


            <p class="text-xs text-slate-400 mt-1">
              Customer account information and authentication settings.
            </p>

          </div>

        </div>


        <!-- Summary -->

        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full lg:w-auto"
        >


          <!-- Member Since -->

          <div
            class="bg-innerCard border border-borderSubtle rounded-xl p-3.5 min-w-[140px]"
          >

            <p
              class="text-[10px] font-bold uppercase tracking-wider text-slate-400"
            >
              Member Since
            </p>

            <p
              class="text-base font-bold text-white mt-1.5"
            >

              <%= user.createdAt
                ? new Date(user.createdAt).toLocaleDateString("en-IN", {
